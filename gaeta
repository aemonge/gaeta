output_format = sys.argv[6]


def append_runtime_log(message: str) -> None:
    runtime_log_path.parent.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
    with runtime_log_path.open("a", encoding="utf-8") as fh:
        fh.write(f"[{timestamp}] {message}\n")


def git_head(path: pathlib.Path) -> str:
    try:
        result = subprocess.run(
            ["git", "-C", str(path), "rev-parse", "HEAD"],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except Exception:
        return ""
    if result.returncode != 0:
        return ""
    return result.stdout.strip()

status_text = status_path.read_text(encoding="utf-8")
checklist_text = checklist_path.read_text(encoding="utf-8")

phase_value = one_line(section_body(status_text, "Current phase"), "unknown")
next_step_value = one_line(section_body(status_text, "Next step"), "(not defined)")
blocker_rows = normalize_bullets(section_body(status_text, "Blockers"), "- none")

pending_sprint: list[str] = []
in_current_sprint = False
for raw in checklist_text.splitlines():
    line = raw.strip()
    if line.startswith("## "):
        in_current_sprint = line == "## Current Sprint"
        continue
    if in_current_sprint and line.startswith("- [ ] "):
        pending_sprint.append(line[6:].strip())

order = ["plan", "build", "review"]
selected_role = "plan"
recovered_cycle = False
head_reset = False
stored_head = ""
current_head = git_head(project)

if cycle_path.exists():
    try:
        payload = json.loads(cycle_path.read_text(encoding="utf-8"))
        if not isinstance(payload, dict):
            payload = {}
            recovered_cycle = True
    except Exception:
        payload = {}
        recovered_cycle = True

    schema = payload.get("schema_version")
    if schema not in (None, 1):
        payload = {}
        recovered_cycle = True

    stored_head = payload.get("last_head") or ""
    if current_head and stored_head and current_head != stored_head:
        selected_role = "plan"
        head_reset = True
    else:
        candidate = payload.get("next_agent")
        if candidate in order:
            selected_role = candidate
        else:
            previous = payload.get("last_agent")
            if previous in order:
                selected_role = order[(order.index(previous) + 1) % len(order)]
            elif payload:
                recovered_cycle = True

next_role = order[(order.index(selected_role) + 1) % len(order)]

cycle_path.parent.mkdir(parents=True, exist_ok=True)
temp_cycle_path = cycle_path.with_suffix(cycle_path.suffix + ".tmp")
temp_cycle_path.write_text(
    json.dumps(
        {
            "schema_version": 1,
            "updated": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
            "last_agent": selected_role,
            "next_agent": next_role,
            "order": order,
            "last_head": current_head,
        },
        indent=2,
    )
    + "\n",
    encoding="utf-8",
)
temp_cycle_path.replace(cycle_path)

if recovered_cycle:
    append_runtime_log("go: recovered cycle state to safe defaults")
if head_reset:
    append_runtime_log("go: reset rotation to plan after git HEAD change")

role_slice = {
    "plan": "Define the smallest approved slice for the current next step with explicit goals and acceptance criteria before editing files.",
    "build": "Implement the top pending sprint item with minimal deterministic edits, then sync checklist/status to match delivered behavior.",
    "review": "Run review checks on the current diff, highlight highest-risk changes, and provide a suggested Conventional Commit message.",
}

role_validation = {
    "plan": [
        "make lint && make test",
        "./gaeta status .",
    ],
    "build": [
        "make lint && make test",
        "./gaeta status .",
        "./gaeta doctor --verbose .",
    ],
    "review": [
        "git status",
        "git diff",
        "git diff --staged",
        "sem (if available)",
    ],
}

print("gaeta go")
print(f"  project: {project}")
print(f"  phase: {phase_value}")
print(f"  next step: {next_step_value}")
print(f"  selected role: {selected_role}")
print("  top pending sprint items:")
if pending_sprint:
    for item in pending_sprint[:5]:
        print(f"    - {item}")
else:
    print("    - none")

print("  blockers:")
for row in blocker_rows[:5]:
    print(f"    {row}")

print(f"  first implementation slice: {role_slice[selected_role]}")
if output_format == "agent":
    print("  validation commands before /review:")
    for cmd in role_validation[selected_role]:
        print(f"    - {cmd}")
print(f"  next role in cycle: {next_role}")
if head_reset:
    print("  rotation note: reset to plan because git HEAD changed.")
PY
  then
    error "failed to render go bundle"
    return 1
  fi

  mkdir -p "$(dirname "$runtime_log")"
  if [[ "$show_mode" -eq 1 ]]; then
    printf '[%s] go: rendered kickoff bundle (show mode)\n' "$(date -Iseconds)" >>"$runtime_log"
  else
