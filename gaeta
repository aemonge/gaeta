    fi
  fi

  if [[ "$fail_count" -gt 0 ]]; then
    return 1
  fi
  if [[ "${DOCTOR_STRICT:-0}" -eq 1 && "$warn_count" -gt 0 ]]; then
    return 1
  fi
  return 0
}

run_resume_command() {
  local target_project="$PWD"
  local show_only=0
  local project_file
  local status_file
  local checklist_file
  local pause_file
  local resume_prompt
  local opencode_bin
  local resume_agent

  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'RESUME_HELP'
Usage:
  gaeta resume [--show] [PROJECT_DIR]
  gaeta r [--show] [PROJECT_DIR]

Launches gaeta in the target project with a generated resume prompt.

Options:
  --show    Show resolved launch command and prompt without executing
RESUME_HELP
    return 0
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --show)
        show_only=1
        shift
        ;;
      *)
        if [[ "$target_project" != "$PWD" ]]; then
          error "resume accepts at most one optional PROJECT_DIR"
          return 1
        fi
        target_project="$1"
        shift
        ;;
    esac
  done

  if [[ ! -d "$target_project" ]]; then
    error "resume project directory does not exist: ${target_project}"
    return 1
  fi

  target_project="$(realpath "$target_project")"
  if ! require_project_initialized "$target_project" "resume"; then
    return 1
  fi
  status_file="${target_project}/docs/.gaeta/status.md"
  checklist_file="${target_project}/docs/.gaeta/checklist.md"
  pause_file="${target_project}/docs/.gaeta/pause.md"
  project_file="${target_project}/PROJECT.md"

  if ! command -v python3 >/dev/null 2>&1; then
    error "python3 is required for resume parsing"
    return 1
  fi

  resume_prompt=$(
    python3 - "$project_file" "$status_file" "$checklist_file" "$pause_file" <<'PY'
import pathlib
import re
import sys


def section_body(text: str, heading: str) -> str:
    pattern = re.compile(rf"^##\s+{re.escape(heading)}\s*$", re.MULTILINE)
    match = pattern.search(text)
    if not match:
        return ""
    start = match.end()
    remaining = text[start:]
    next_heading = re.search(r"^##\s+", remaining, re.MULTILINE)
    if next_heading:
        return remaining[: next_heading.start()].strip()
    return remaining.strip()


project_path = pathlib.Path(sys.argv[1])
status_path = pathlib.Path(sys.argv[2])
checklist_path = pathlib.Path(sys.argv[3])
pause_path = pathlib.Path(sys.argv[4])

project_text = project_path.read_text(encoding="utf-8") if project_path.exists() else ""
status_text = status_path.read_text(encoding="utf-8") if status_path.exists() else ""
checklist_text = checklist_path.read_text(encoding="utf-8") if checklist_path.exists() else ""
snapshot_text = pause_path.read_text(encoding="utf-8") if pause_path.exists() else ""

snapshot_phase = section_body(snapshot_text, "Current phase")
snapshot_next = section_body(snapshot_text, "Next step")
snapshot_project_update = section_body(snapshot_text, "Project update")
snapshot_conversation = section_body(snapshot_text, "Conversation summary")
snapshot_attempts = section_body(snapshot_text, "Attempts and outcomes")
snapshot_decisions = section_body(snapshot_text, "Decisions")
snapshot_frozen = section_body(snapshot_text, "Frozen items")
snapshot_blockers = section_body(snapshot_text, "Blockers")

if snapshot_text and (snapshot_project_update or snapshot_conversation or snapshot_attempts or snapshot_decisions or snapshot_frozen):
    phase_value = " ".join(line.strip() for line in snapshot_phase.splitlines() if line.strip()) or "unknown"
    next_value = " ".join(line.strip() for line in snapshot_next.splitlines() if line.strip()) or "(not defined)"
    project_update_value = " ".join(line.strip() for line in snapshot_project_update.splitlines() if line.strip()) or "(not recorded)"
    conversation_value = " ".join(line.strip() for line in snapshot_conversation.splitlines() if line.strip()) or "(not recorded)"
    attempts_value = " ".join(line.strip() for line in snapshot_attempts.splitlines() if line.strip()) or "(not recorded)"
    decisions_value = " ".join(line.strip() for line in snapshot_decisions.splitlines() if line.strip()) or "(not recorded)"
    frozen_value = " ".join(line.strip() for line in snapshot_frozen.splitlines() if line.strip()) or "(none)"
    blockers_value = " ".join(line.strip() for line in snapshot_blockers.splitlines() if line.strip()) or "(none)"

    resume_prompt = (
        f"Phase: {phase_value}. Next: {next_value}. "
        f"Project update: {project_update_value}. "
        f"Conversation summary: {conversation_value}. "
        f"Attempts and outcomes: {attempts_value}. "
        f"Decisions: {decisions_value}. "
        f"Frozen items: {frozen_value}. "
        f"Blockers: {blockers_value}. "
        "Read AGENTS.md and docs/.gaeta files plus PROJECT.md and GAETA.md. "
        "Provide a concise read-only handoff and propose the first implementation slice and validation commands."
    )
    print(resume_prompt)
    raise SystemExit(0)

resume_prompt_body = section_body(project_text, "Resume Prompt")
resume_prompt = ""
for line in resume_prompt_body.splitlines():
    line = line.strip()
    if line.startswith("`") and line.endswith("`") and len(line) > 2:
        resume_prompt = line.strip("`")
        break

if not resume_prompt:
    phase_line = section_body(status_text, "Current phase").splitlines()
    phase_value = phase_line[0].strip() if phase_line else "unknown"
    next_step_line = section_body(status_text, "Next step").splitlines()
    next_value = " ".join(line.strip() for line in next_step_line if line.strip()) if next_step_line else "(not defined)"

    pending = []
    in_current_sprint = False
    for raw in checklist_text.splitlines():
        line = raw.strip()
        if line.startswith("## "):
            in_current_sprint = line == "## Current Sprint"
            continue
        if in_current_sprint and line.startswith("- [ ] "):
            pending.append(line[6:].strip())

    resume_prompt = (
        f"Phase: {phase_value}. Next: {next_value}. "
        f"Pending sprint items: {', '.join(pending[:3]) if pending else 'none'}. "
        "Read AGENTS.md and docs/.gaeta files plus PROJECT.md and GAETA.md. "
        "Provide a read-only handoff summary and propose the first implementation slice and validation commands."
    )

print(resume_prompt)
PY
  )

  if [[ -z "$resume_prompt" ]]; then
    error "failed to resolve resume prompt"
    return 1
  fi

  opencode_bin="${OPENCODE_BIN:-${OPENCODE_BIN_DEFAULT}}"
  resume_agent="${GAETA_RESUME_AGENT:-plan}"

  if [[ -z "$resume_agent" ]]; then
    resume_agent="plan"
  fi

  if [[ "$show_only" -eq 1 ]]; then
    printf 'gaeta resume\n'
    printf '  project: %s\n' "$target_project"
    printf '  opencode: %s\n' "$opencode_bin"
    printf '  agent: %s\n' "$resume_agent"
    printf '  launch: %s %s -- --agent %s --prompt "%s"\n' "$GAETA_SELF_PATH" "$target_project" "$resume_agent" "$resume_prompt"
    printf '\nResume prompt\n  %s\n' "$resume_prompt"
    return 0
  fi

  exec "$GAETA_SELF_PATH" "$target_project" -- --agent "$resume_agent" --prompt "$resume_prompt"
}

