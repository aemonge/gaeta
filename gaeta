determine_tty_session_mode() {
  local requested_mode="$GAETA_TTY_MODE_REQUEST"

  TTY_INTERACTIVE=0
  if [[ -t 0 && -t 1 ]]; then
    TTY_INTERACTIVE=1
  fi

  if [[ "$STRICT_TTY" -eq 1 ]]; then
    requested_mode="strict"
  fi

  case "$requested_mode" in
    auto)
      if [[ "$TTY_INTERACTIVE" -eq 1 ]]; then
        TTY_SESSION_MODE="compat"
        TTY_SESSION_REASON="auto-interactive"
      else
        TTY_SESSION_MODE="strict"
        TTY_SESSION_REASON="auto-non-interactive"
      fi
      ;;
    compat)
      TTY_SESSION_MODE="compat"
      TTY_SESSION_REASON="explicit-compat"
      ;;
    strict)
      TTY_SESSION_MODE="strict"
      TTY_SESSION_REASON="explicit-strict"
      ;;
    *)
      error "invalid GAETA_TTY_MODE='${GAETA_TTY_MODE_REQUEST}' (expected auto|compat|strict)"
      return 1
      ;;
  esac

  return 0
}

