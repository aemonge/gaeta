# -------- option parsing --------
RO_SET=0
RW_SET=0
ALLOW_GIT=0
ALLOW_NODE_MODULES=1
ALLOW_VENV=1
ALLOW_INFRA=0
RESTRICT_DEV=0
PARSE_DONE=0

while [[ $# -gt 0 ]]; do
  if [[ "$PARSE_DONE" -eq 1 ]]; then
    OPENCODE_ARGS+=("$1")
    shift
    continue
  fi

  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -V | --version)
      version
      exit 0
      ;;
    -q | --quiet)
      QUIET=1
      shift
      ;;
    --validate)
      VALIDATE_MODE=1
      shift
      ;;
    -n | --no-net)
      NET_MODE="off"
      shift
      ;;
    -b | --bin)
      if [[ $# -lt 2 ]]; then
        error "missing argument for $1"
        exit 1
      fi
      OPENCODE_BIN="$2"
      shift 2
      ;;
    --ro)
      RO_SET=1
      FS_MODE="ro"
      shift
      ;;
    --rw)
      RW_SET=1
      FS_MODE="rw"
      shift
      ;;
    --allow-git)
      ALLOW_GIT=1
      shift
      ;;
    --allow-node-modules)
      ALLOW_NODE_MODULES=1
      shift
      ;;
    --allow-venv)
      ALLOW_VENV=1
      shift
      ;;
    --quiet-landlock | --quite-landlock)
      QUIET_LANDLOCK=1
      shift
      ;;
    --require-landlock)
      REQUIRE_LANDLOCK=1
      shift
      ;;
    --strict-tty)
      STRICT_TTY=1
      shift
      ;;
    --allow-infra)
      ALLOW_INFRA=1
      shift
      ;;
    --allow-host-tools)
      ALLOW_HOST_TOOLS=1
      ALLOW_HOST_TOOLS_SET=1
      shift
      ;;
    --no-host-tools)
      ALLOW_HOST_TOOLS=0
      ALLOW_HOST_TOOLS_DISABLE_SET=1
      shift
      ;;
    --restrict-dev)
      RESTRICT_DEV=1
      shift
      ;;
    -P | --not-paranoid | --no-paranoid)
      NOT_PARANOID=1
      shift
      ;;
    --)
      PARSE_DONE=1
      shift
      ;;
    -*)
      error "unknown option: $1"
      echo "Try '${PROGRAM_NAME} --help' for more information." >&2
      exit 1
      ;;
    *)
      if [[ -z "$PROJECT_DIR" ]]; then
        PROJECT_DIR="$1"
      else
        error "unexpected argument before '--': $1"
        echo "Try '${PROGRAM_NAME} --help' for more information." >&2
        exit 1
      fi
      shift
      ;;
  esac
done

