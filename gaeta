run_profile_command() {
  local action="show"
  local profile_name=""
  local target_project="$PWD"
  local -a args=("$@")

  if [[ "${args[0]:-}" == "-h" || "${args[0]:-}" == "--help" ]]; then
    cat <<'PROFILE_HELP'
Usage:
  gaeta profile [PROJECT_DIR]
  gaeta profile list
  gaeta profile set <minimal|recommended|experimental> [PROJECT_DIR]
  gaeta profile sync [--dry-run] [--install] [--profile <name>] [--yes] [PROJECT_DIR]
PROFILE_HELP
    return 0
  fi

  if [[ "${args[0]:-}" == "list" ]]; then
    print_profile_catalog
    return 0
  fi

  if [[ "${args[0]:-}" == "sync" ]]; then
    args=("${args[@]:1}")
    run_profile_sync_command "${args[@]}"
    return $?
  fi

  if [[ "${args[0]:-}" == "set" ]]; then
    if [[ ${#args[@]} -lt 2 ]]; then
      error "profile set requires a profile name"
      return 1
    fi
    profile_name="${args[1]}"
    if ! profile_exists "$profile_name"; then
      error "unsupported profile: ${profile_name}"
      return 1
    fi
    if [[ ${#args[@]} -ge 3 ]]; then
      target_project="${args[2]}"
    fi
    action="set"
  elif [[ ${#args[@]} -ge 1 ]]; then
    target_project="${args[0]}"
  fi

  if [[ ! -d "$target_project" ]]; then
    error "profile project directory does not exist: ${target_project}"
    return 1
  fi
  target_project="$(realpath "$target_project")"

  if [[ "$action" == "set" ]]; then
    if ! write_profile_metadata "$target_project" "$profile_name"; then
      return 1
    fi
    printf 'gaeta profile\n'
    printf '  project: %s\n' "$target_project"
    printf '  active: %s\n' "$profile_name"
    return 0
  fi

  profile_name="$(detect_profile_name "$target_project")"
  printf 'gaeta profile\n'
  printf '  project: %s\n' "$target_project"
  printf '  active: %s\n' "$profile_name"
  printf '  profiles:\n'
  while IFS= read -r row; do
    printf '    - %s\n' "$row"
  done < <(print_profile_catalog)
  return 0
}

