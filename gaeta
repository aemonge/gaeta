run_doctor_command() {
  local target_project="$PWD"
  local doctor_json_flag=0
  local doctor_verbose_flag=0
  local doctor_strict_flag=1
  local -a doctor_positionals=()

  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'DOCTOR_HELP'
Usage:
  gaeta doctor [--json] [--verbose] [--strict|--no-strict] [PROJECT_DIR]

Runs gaeta self-inspection checks for dependencies, config source selection,
projection artifacts, and workflow files.

Options:
  --json      Emit machine-readable JSON output
  --verbose   Emit full human-readable check table
  --strict    Exit non-zero on warnings or failures (default)
  --no-strict Exit non-zero only on failures
DOCTOR_HELP
    return 0
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)
        doctor_json_flag=1
        ;;
      --verbose)
        doctor_verbose_flag=1
        ;;
      --strict)
        doctor_strict_flag=1
        ;;
      --no-strict)
        doctor_strict_flag=0
        ;;
      *)
        doctor_positionals+=("$1")
        ;;
    esac
    shift
  done

  if [[ ${#doctor_positionals[@]} -gt 1 ]]; then
    error "doctor accepts at most one optional PROJECT_DIR"
    return 1
  fi

  if [[ ${#doctor_positionals[@]} -eq 1 ]]; then
    target_project="${doctor_positionals[0]}"
  fi

  if [[ ! -d "$target_project" ]]; then
    error "doctor project directory does not exist: ${target_project}"
    return 1
  fi

  target_project="$(realpath "$target_project")"
  PROJECT_DIR="$target_project"

  init_projection_paths
  GAETA_META_ENABLED=1
  mkdir -p "$GAETA_PROJECTION_DIR" 2>/dev/null || true

  local fail_count=0
  local warn_count=0
  local generated_at
  generated_at="$(date -Iseconds)"

  DOCTOR_JSON=${doctor_json_flag}
  DOCTOR_VERBOSE=${doctor_verbose_flag}
  DOCTOR_STRICT=${doctor_strict_flag}
  DOCTOR_COLLECT=1
  CURRENT_DOCTOR_SECTION=""
  local -a DOCTOR_CHECK_ROWS=()

  local opencode_bin_check="${OPENCODE_BIN:-${OPENCODE_BIN_DEFAULT}}"
  local gaeta_config_dir="${HOME}/.config/gaeta"
  local opencode_config_dir="${HOME}/.config/opencode"

  local gaeta_opencode_json="${gaeta_config_dir}/opencode.json"
  local opencode_opencode_json="${opencode_config_dir}/opencode.json"
  local gaeta_tui_json="${gaeta_config_dir}/tui.json"
  local opencode_tui_json="${opencode_config_dir}/tui.json"

  local gaeta_agents_dir="${gaeta_config_dir}/agents"
  local opencode_agents_dir="${opencode_config_dir}/agents"
  local gaeta_commands_dir="${gaeta_config_dir}/commands"
  local opencode_commands_dir="${opencode_config_dir}/commands"
  local gaeta_modes_dir="${gaeta_config_dir}/modes"
  local opencode_modes_dir="${opencode_config_dir}/modes"
  local gaeta_plugins_dir="${gaeta_config_dir}/plugins"
  local opencode_plugins_dir="${opencode_config_dir}/plugins"
  local gaeta_plugin_dir="${gaeta_config_dir}/plugin"
  local opencode_plugin_dir="${opencode_config_dir}/plugin"

  local projection_dir="${target_project}/.gaeta/projection"
  local projection_meta="${projection_dir}/projection.json"

  local opencode_mode
  local tui_mode
  local agents_mode
  local commands_mode
  local modes_mode
  local plugins_mode
  local plugin_mode

  opencode_mode=$(detect_file_source_mode "$gaeta_opencode_json" "$opencode_opencode_json")
  tui_mode=$(detect_file_source_mode "$gaeta_tui_json" "$opencode_tui_json")
  agents_mode=$(detect_dir_source_mode "$gaeta_agents_dir" "$opencode_agents_dir")
  commands_mode=$(detect_dir_source_mode "$gaeta_commands_dir" "$opencode_commands_dir")
  modes_mode=$(detect_dir_source_mode "$gaeta_modes_dir" "$opencode_modes_dir")
  plugins_mode=$(detect_dir_source_mode "$gaeta_plugins_dir" "$opencode_plugins_dir")
  plugin_mode=$(detect_dir_source_mode "$gaeta_plugin_dir" "$opencode_plugin_dir")

  if ! determine_tty_session_mode; then
    return 1
  fi

  local projection_refresh_state="ok"
  local projection_refresh_details="refreshed projection artifacts"
  local previous_quiet="$QUIET"
  QUIET=1
  if ! prepare_projection_artifacts; then
    projection_refresh_state="warn"
    projection_refresh_details="failed to refresh projection artifacts"
    ((warn_count += 1))
