write_command_json() {
    local mode="$1"
    local command_path="$2"
    if [[ "${GAETA_META_ENABLED:-0}" -ne 1 ]]; then
        return
    fi

    local project_json
    local mode_json
    local cmd_json
    local args_json=""
    local index=0
    project_json=$(json_escape "${PROJECT_DIR}")
    mode_json=$(json_escape "${mode}")
    cmd_json=$(json_escape "${command_path}")

    for arg in "${OPENCODE_ARGS[@]}"; do
        local escaped
        escaped=$(json_escape "${arg}")
        if [[ "${index}" -gt 0 ]]; then
            args_json+=$',\n'
        fi
        args_json+="    \"${escaped}\""
        ((index += 1))
    done

    cat >"${GAETA_COMMAND_JSON}" <<EOF
{
  "timestamp": "$(date -Iseconds)",
  "project_dir": "${project_json}",
  "mode": "${mode_json}",
  "network": "${NET_MODE}",
  "fs_mode": "${FS_MODE}",
  "allow_git": ${ALLOW_GIT},
  "allow_node_modules": ${ALLOW_NODE_MODULES},
  "allow_venv": ${ALLOW_VENV},
  "allow_infra": ${ALLOW_INFRA},
  "allow_host_tools": ${ALLOW_HOST_TOOLS},
  "strict_tty": ${STRICT_TTY},
  "tty_mode": "${TTY_SESSION_MODE}",
  "tty_mode_reason": "${TTY_SESSION_REASON}",
  "tty_interactive": ${TTY_INTERACTIVE},
  "not_paranoid": ${NOT_PARANOID},
  "quiet_landlock": ${QUIET_LANDLOCK},
  "require_landlock": ${REQUIRE_LANDLOCK},
  "command": "${cmd_json}",
  "opencode_args": [
${args_json}
  ]
}
EOF
}

