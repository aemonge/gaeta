run_profile_sync_command() {
  local target_project="$PWD"
  local dry_run=0
  local install_mode=0
  local assume_yes=0
  local include_notify=1
  local profile_override=""
  local -a positionals=()

  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'PROFILE_SYNC_HELP'
Usage:
  gaeta profile sync [--dry-run] [--install] [--profile <name>] [--yes] [--no-notify] [PROJECT_DIR]

Behavior:
  - computes expected/configured/missing/blocked plugin state for active profile
  - writes .gaeta/profile.lock.json and .opencode/gaeta-profile.* (unless --dry-run)
  - never installs hard-blocked plugins
  - only performs installation actions when --install is passed
PROFILE_SYNC_HELP
    return 0
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        dry_run=1
        ;;
      --install)
        install_mode=1
        ;;
      --yes)
        assume_yes=1
        ;;
      --no-notify)
        include_notify=0
        ;;
      --notify)
        include_notify=1
        ;;
      --profile)
        if [[ $# -lt 2 ]]; then
          error "profile sync --profile requires one value"
          return 1
        fi
        profile_override="$2"
        shift
        ;;
      --profile=*)
        profile_override="${1#--profile=}"
        ;;
      -*)
        error "unknown profile sync option: $1"
        return 1
        ;;
      *)
        positionals+=("$1")
        ;;
    esac
    shift
  done

  if [[ ${#positionals[@]} -gt 1 ]]; then
    error "profile sync accepts at most one optional PROJECT_DIR"
    return 1
  fi
  if [[ ${#positionals[@]} -eq 1 ]]; then
    target_project="${positionals[0]}"
  fi

  if [[ ! -d "$target_project" ]]; then
    error "profile sync project directory does not exist: ${target_project}"
    return 1
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    error "python3 is required for profile sync"
    return 1
  fi

  target_project="$(realpath "$target_project")"
  if [[ -n "$profile_override" ]] && ! profile_exists "$profile_override"; then
    error "unsupported profile: ${profile_override}"
    return 1
  fi

  local active_profile
  active_profile="$(detect_profile_name "$target_project")"
  if [[ -n "$profile_override" ]]; then
    active_profile="$profile_override"
  fi

  if [[ "$dry_run" -eq 1 && "$install_mode" -eq 1 ]]; then
    error "profile sync --dry-run and --install are mutually exclusive"
    return 1
  fi

  if [[ "$dry_run" -eq 0 && -n "$profile_override" ]]; then
    if ! write_profile_metadata "$target_project" "$active_profile"; then
      return 1
    fi
  fi

  local ocx_available=0
  if command -v ocx >/dev/null 2>&1; then
    ocx_available=1
  fi

  local registry_path=""
  local -a registry_candidates=()
  if [[ -n "${GAETA_PLUGIN_REGISTRY:-}" ]]; then
    registry_candidates+=("${GAETA_PLUGIN_REGISTRY}")
  fi
  registry_candidates+=(
    "$PWD/packs/opencode/plugins.json"
    "$(dirname "$GAETA_SELF_PATH")/packs/opencode/plugins.json"
    "$(dirname "$GAETA_SELF_PATH")/../packs/opencode/plugins.json"
    "$HOME/.config/gaeta/packs/opencode/plugins.json"
  )

  local candidate
  for candidate in "${registry_candidates[@]}"; do
    if [[ -f "$candidate" ]]; then
      registry_path="$(realpath "$candidate")"
      break
    fi
  done

  if [[ -z "$registry_path" ]]; then
    error "profile plugin registry missing (set GAETA_PLUGIN_REGISTRY or ensure packs/opencode/plugins.json exists)"
    return 1
  fi

  if ! python3 - "$target_project" "$active_profile" "$dry_run" "$install_mode" "$assume_yes" "$HOME" "$ocx_available" "$registry_path" "$PROGRAM_VERSION" "$include_notify" <<'PY'
import datetime
import json
import pathlib
import shutil
import sys


def normalize_plugin_id(name: str) -> str:
    value = name.strip().lower()
    for suffix in (".js", ".mjs", ".cjs", ".ts", ".json"):
        if value.endswith(suffix):
            value = value[: -len(suffix)]
    for ch in ("_", " "):
        value = value.replace(ch, "-")
    while "--" in value:
        value = value.replace("--", "-")
    return value.strip("-")

project = pathlib.Path(sys.argv[1]).resolve()
profile = sys.argv[2]
dry_run = sys.argv[3] == "1"
install_mode = sys.argv[4] == "1"
assume_yes = sys.argv[5] == "1"
home = pathlib.Path(sys.argv[6]).expanduser()
ocx_available = sys.argv[7] == "1"
registry_path = pathlib.Path(sys.argv[8])
gaeta_version = sys.argv[9]
include_notify = sys.argv[10] == "1"

registry = json.loads(registry_path.read_text(encoding="utf-8"))
blocked = {normalize_plugin_id(item) for item in registry.get("blocked", []) if isinstance(item, str)}
plugins_registry = registry.get("plugins", {}) if isinstance(registry, dict) else {}

expected_rules = []
for plugin_id, raw in plugins_registry.items():
    if not isinstance(raw, dict):
        continue
    if profile not in raw.get("profiles", []):
        continue
    if raw.get("optional", False) and plugin_id == "notify" and not include_notify:
        continue
    item = dict(raw)
    item["id"] = plugin_id
    expected_rules.append(item)

expected_rules.sort(key=lambda row: row["id"])
expected_ids = [row["id"] for row in expected_rules]
optional_skipped = ["notify"] if (not include_notify and "notify" in plugins_registry and profile in plugins_registry["notify"].get("profiles", [])) else []

project_opencode_path = project / "opencode.json"
project_payload = {}
project_json_exists = project_opencode_path.exists()
if project_json_exists:
    try:
        project_payload = json.loads(project_opencode_path.read_text(encoding="utf-8"))
    except Exception:
        project_payload = {}
if not isinstance(project_payload, dict):
    project_payload = {}

plugin_specs = project_payload.get("plugin")
if not isinstance(plugin_specs, list):
    plugin_specs = []

def dedupe_specs(rows: list[str]) -> list[str]:
    seen = set()
    out = []
    for row in rows:
        if not isinstance(row, str):
            continue
        spec = row.strip()
        if not spec:
            continue
        if spec in seen:
            continue
        seen.add(spec)
        out.append(spec)
    return out


current_specs = dedupe_specs(plugin_specs)
spec_to_id = {}
for pid, raw in plugins_registry.items():
    if not isinstance(raw, dict):
        continue
    install = raw.get("install", {})
    if isinstance(install, dict) and install.get("type") == "opencode-plugin":
        spec = install.get("spec")
        if isinstance(spec, str) and spec.strip():
            spec_to_id[spec.strip()] = pid

configured_ids = set()
configured_specs = []
for spec in current_specs:
    configured_specs.append(spec)
    mapped = spec_to_id.get(spec)
    if mapped:
        configured_ids.add(mapped)
    else:
        normalized = normalize_plugin_id(spec)
        if normalized in plugins_registry:
            configured_ids.add(normalized)

if ocx_available or shutil.which("ocx"):
    configured_ids.add("ocx")

blocked_detected = []
for spec in current_specs:
    normalized = normalize_plugin_id(spec)
    if normalized in blocked:
        blocked_detected.append(spec)
blocked_detected = sorted(set(blocked_detected))

auto_install_specs = []
manual_plugins = []
manual_suggestions = []
manual_unverified = []
missing_ids = []

for rule in expected_rules:
    pid = rule["id"]
    install = rule.get("install", {}) if isinstance(rule.get("install"), dict) else {}
    install_type = install.get("type", "manual")
    label = rule.get("label", pid)

    is_configured = pid in configured_ids

    if install_type == "opencode-plugin":
        spec = install.get("spec")
        if isinstance(spec, str) and spec.strip():
            auto_install_specs.append(spec.strip())
            if spec.strip() in current_specs:
                is_configured = True
        else:
            install_type = "manual"

    elif install_type == "executable":
        command = install.get("command", pid)
        if isinstance(command, str) and command.strip() and shutil.which(command.strip()):
            is_configured = True
        else:
            is_configured = False

    if not is_configured:
        missing_ids.append(pid)

    if install_type in {"manual", "executable"}:
        if install_type == "executable":
            command = install.get("command", pid)
            if isinstance(command, str) and command.strip() and not shutil.which(command.strip()):
                manual_plugins.append(f"{pid}: executable `{command.strip()}` not found")
                manual_suggestions.append(f"npm install -g {command.strip()}  # verify source before install")
        else:
            notes = rule.get("notes", "manual setup required")
            manual_plugins.append(f"{pid}: {notes}")
            manual_unverified.append(f"{pid}: no verified npm package name; check plugin docs/registry before install")

projected_specs = list(current_specs)
added_specs = []
if install_mode:
    for spec in auto_install_specs:
        if spec not in projected_specs:
            projected_specs.append(spec)
            added_specs.append(spec)

    if blocked_detected:
        projected_specs = [spec for spec in projected_specs if spec not in blocked_detected]

projected_specs = dedupe_specs(projected_specs)

configured_after_ids = set(configured_ids)
for spec in projected_specs:
    mapped = spec_to_id.get(spec)
    if mapped:
        configured_after_ids.add(mapped)
    else:
        normalized = normalize_plugin_id(spec)
        if normalized in plugins_registry:
            configured_after_ids.add(normalized)

missing_after = [pid for pid in expected_ids if pid not in configured_after_ids]

timestamp = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")

lock_payload = {
    "schema_version": 2,
    "generated_at": timestamp,
    "gaeta_version": gaeta_version,
    "profile": profile,
    "direnv_mode": "off",
    "install": {
        "requested": install_mode,
        "assume_yes": assume_yes,
        "notify_enabled": include_notify,
        "applied_specs": added_specs,
        "manual_pending": manual_plugins,
        "manual_suggestions": sorted(set(manual_suggestions)),
        "manual_unverified": sorted(set(manual_unverified)),
    },
    "plugins": {
        "expected_ids": expected_ids,
        "configured_specs": projected_specs if install_mode else current_specs,
        "auto_installable_specs": sorted(set(auto_install_specs)),
        "manual_ids": sorted({entry.split(":", 1)[0] for entry in manual_plugins}),
        "missing_ids": missing_after if install_mode else missing_ids,
        "optional_skipped_ids": optional_skipped,
        "blocked_detected_specs": blocked_detected,
        "recommended_excludes": ["opencode-browser", "opencode-skills"],
    },
    "policy": {
        "blocked_plugin_ids": sorted(blocked),
        "allow_arbitrary_installs": False,
    },
}

generated_json = {
    "gaeta": {
        "profile": profile,
        "plugin_state": lock_payload["plugins"],
        "direnv_mode": "off",
        "artifact_root": ".gaeta/artifacts",
        "phase_control": "docs/.gaeta/*",
        "status_hint": "Run `gaeta profile sync --dry-run` for preview or `gaeta profile sync --install` to project curated plugin specs.",
    }
}

if not dry_run:
    if install_mode:
        project_payload["plugin"] = projected_specs
        project_opencode_path.write_text(json.dumps(project_payload, indent=2, ensure_ascii=True) + "\n", encoding="utf-8")

    lock_path = project / ".gaeta" / "profile.lock.json"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    lock_path.write_text(json.dumps(lock_payload, indent=2, ensure_ascii=True) + "\n", encoding="utf-8")

    opencode_dir = project / ".opencode"
    opencode_dir.mkdir(parents=True, exist_ok=True)
    generated_json_path = opencode_dir / "gaeta.generated.json"
    generated_json_path.write_text(json.dumps(generated_json, indent=2, ensure_ascii=True) + "\n", encoding="utf-8")

    generated_md_path = opencode_dir / "gaeta-profile.md"
    md_lines = [
        "# Gaeta Profile Context",
        "",
        f"- active profile: `{profile}`",
        f"- direnv mode: `off`",
        f"- expected plugins: {', '.join(expected_ids) if expected_ids else 'none (minimal policy)'}",
        f"- configured plugin specs: {', '.join(lock_payload['plugins']['configured_specs']) if lock_payload['plugins']['configured_specs'] else 'none'}",
        f"- missing expected plugins: {', '.join(lock_payload['plugins']['missing_ids']) if lock_payload['plugins']['missing_ids'] else 'none'}",
        f"- manual pending plugins: {', '.join(lock_payload['plugins']['manual_ids']) if lock_payload['plugins']['manual_ids'] else 'none'}",
        f"- blocked detected specs: {', '.join(blocked_detected) if blocked_detected else 'none'}",
        "",
        "## Policy",
        "",
        "- hard blocked plugins: google-ai-search, telegram-bot, swarm-plugin, agent-of-empires, devcontainers",
        "- recommended excludes: opencode-browser, opencode-skills",
        "- sandbox authority remains in gaeta wrapper boundary",
        "",
        "## Next command",
        "",
        "- run `gaeta doctor --strict .`",
    ]
    generated_md_path.write_text("\n".join(md_lines) + "\n", encoding="utf-8")

print("gaeta profile sync")
print(f"  project: {project}")
print(f"  profile: {profile}")
print(f"  mode: {'dry-run' if dry_run else ('install' if install_mode else 'sync')}")
print(f"  current opencode plugin specs: {', '.join(current_specs) if current_specs else 'none'}")
print(f"  expected plugins: {', '.join(expected_ids) if expected_ids else 'none (minimal)'}")
print(f"  auto-installable specs: {', '.join(sorted(set(auto_install_specs))) if auto_install_specs else 'none'}")
print(f"  manual plugins: {', '.join(sorted({entry.split(':', 1)[0] for entry in manual_plugins})) if manual_plugins else 'none'}")
print(f"  missing expected: {', '.join(lock_payload['plugins']['missing_ids']) if lock_payload['plugins']['missing_ids'] else 'none'}")
print(f"  blocked detected: {', '.join(blocked_detected) if blocked_detected else 'none'}")

if dry_run:
    print("  planned writes: opencode.json plugin field, .gaeta/profile.lock.json, .opencode/gaeta.generated.json, .opencode/gaeta-profile.md")
else:
    if install_mode:
        print(f"  wrote: {project_opencode_path.relative_to(project)}")
    print("  wrote: .gaeta/profile.lock.json")
    print("  wrote: .opencode/gaeta.generated.json")
    print("  wrote: .opencode/gaeta-profile.md")

if manual_plugins:
    print("  manual actions:")
    for row in manual_plugins:
        print(f"    - {row}")

if manual_suggestions:
    print("  suggested install commands:")
    for row in sorted(set(manual_suggestions)):
        print(f"    - {row}")

if manual_unverified:
