    fi
    exit 0
fi

# Command dispatch: gaeta resume / r ...
if [[ "${1:-}" == "resume" || "${1:-}" == "r" ]]; then
    shift
    if ! run_resume_command "$@"; then
        exit 1
    fi
    exit 0
fi

# Command dispatch: gaeta tasks ...
if [[ "${1:-}" == "tasks" ]]; then
    shift
    if ! run_tasks_command "${PWD}" "$@"; then
        exit 1
    fi
    exit 0
fi

# -------- option parsing --------
RO_SET=0
RW_SET=0
ALLOW_GIT=0
ALLOW_NODE_MODULES=1
ALLOW_VENV=1
ALLOW_INFRA=0
RESTRICT_DEV=0
PARSE_DONE=0

while [[ $# -gt 0 ]]; do
    if [[ "${PARSE_DONE}" -eq 1 ]]; then
        OPENCODE_ARGS+=("$1")
        shift
        continue
    fi

    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -V | --version)
        version
        exit 0
        ;;
    -q | --quiet)
        QUIET=1
        shift
        ;;
    --validate)
        VALIDATE_MODE=1
        shift
        ;;
    -n | --no-net)
        NET_MODE="off"
        shift
        ;;
    -b | --bin)
        if [[ $# -lt 2 ]]; then
            error "missing argument for $1"
            exit 1
        fi
        OPENCODE_BIN="$2"
        shift 2
        ;;
    --ro)
        RO_SET=1
        FS_MODE="ro"
        shift
        ;;
    --rw)
        RW_SET=1
        FS_MODE="rw"
        shift
        ;;
    --allow-git)
        ALLOW_GIT=1
        shift
        ;;
    --allow-node-modules)
        ALLOW_NODE_MODULES=1
        shift
        ;;
    --allow-venv)
        ALLOW_VENV=1
        shift
        ;;
    --quiet-landlock | --quite-landlock)
        QUIET_LANDLOCK=1
        shift
        ;;
    --require-landlock)
        REQUIRE_LANDLOCK=1
        shift
        ;;
    --strict-tty)
        STRICT_TTY=1
        shift
        ;;
    --allow-infra)
        ALLOW_INFRA=1
        shift
        ;;
    --allow-host-tools)
        ALLOW_HOST_TOOLS=1
        ALLOW_HOST_TOOLS_SET=1
        shift
        ;;
    --no-host-tools)
        ALLOW_HOST_TOOLS=0
        ALLOW_HOST_TOOLS_DISABLE_SET=1
        shift
        ;;
    --restrict-dev)
        RESTRICT_DEV=1
        shift
        ;;
    -P | --not-paranoid | --no-paranoid)
        NOT_PARANOID=1
        shift
        ;;
    --)
        PARSE_DONE=1
        shift
        ;;
    -*)
        error "unknown option: $1"
        echo "Try '${PROGRAM_NAME} --help' for more information." >&2
        exit 1
        ;;
    *)
        if [[ -z "${PROJECT_DIR}" ]]; then
            PROJECT_DIR="$1"
        else
            error "unexpected argument before '--': $1"
            echo "Try '${PROGRAM_NAME} --help' for more information." >&2
            exit 1
        fi
        shift
        ;;
    esac
done

# ====== PARANOID MODE: Early Detection ======
detect_landrun

# Handle validation mode
if [[ "${VALIDATE_MODE}" -eq 1 ]]; then
    run_validation
    exit $?
fi

# Check for conflicting flags
if [[ "${RO_SET}" -eq 1 && "${RW_SET}" -eq 1 ]]; then
    error "--ro and --rw are mutually exclusive"
    exit 1
fi

if [[ "${ALLOW_HOST_TOOLS_SET}" -eq 1 && "${ALLOW_HOST_TOOLS_DISABLE_SET}" -eq 1 ]]; then
    error "--allow-host-tools and --no-host-tools are mutually exclusive"
    exit 1
fi

# PROJECT_DIR default
if [[ -z "${PROJECT_DIR}" ]]; then
    PROJECT_DIR="${PWD}"
fi

update_phase "parsed"

# -------- validation --------
if ! command -v bwrap >/dev/null 2>&1; then
    error "bubblewrap (bwrap) not found in PATH"
    error "install: pacman -S bubblewrap  # Arch/Manjaro"
    error "         apt install bubblewrap  # Debian/Ubuntu"
    error "         dnf install bubblewrap  # Fedora/RHEL"
    exit 1
fi

BWRAP_DISABLE_USERNS_SUPPORTED=0
if bwrap --help 2>/dev/null | grep -q -- "--disable-userns"; then
    BWRAP_DISABLE_USERNS_SUPPORTED=1
fi

if ! command -v "${OPENCODE_BIN}" >/dev/null 2>&1; then
    error "opencode binary not found: ${OPENCODE_BIN}"
    exit 1
fi

if [[ ! -d "${PROJECT_DIR}" ]]; then
    error "project directory does not exist: ${PROJECT_DIR}"
    exit 1
fi

if [[ "${FS_MODE}" != "ro" && "${FS_MODE}" != "rw" ]]; then
    error "invalid FS mode '${FS_MODE}' (expected 'ro' or 'rw')"
    exit 1
fi

PROJECT_DIR="$(realpath "${PROJECT_DIR}")"
SANDBOX_WORKDIR="${PROJECT_DIR}"

init_metadata_dir
update_phase "validated"
append_session_log "starting session for ${PROJECT_DIR}"

if [[ "${ALLOW_GIT}" -eq 1 ]]; then
    append_approval_log "--allow-git enabled"
fi
if [[ "${ALLOW_INFRA}" -eq 1 ]]; then
    append_approval_log "--allow-infra enabled"
fi
if [[ "${NOT_PARANOID}" -eq 1 ]]; then
    append_approval_log "--not-paranoid enabled"
fi
if [[ "${REQUIRE_LANDLOCK}" -eq 1 ]]; then
    append_approval_log "--require-landlock enabled"
fi

if ! prepare_projection_artifacts; then
    exit 1
fi

if ! determine_tty_session_mode; then
    exit 1
fi

# Network flags
NET_FLAGS=()
if [[ "${NET_MODE}" != "on" ]]; then
    NET_FLAGS+=(--unshare-net)
fi

# FS bind mode
if [[ "${FS_MODE}" = "ro" ]]; then
    BIND_FLAG="--ro-bind"
else
    BIND_FLAG="--bind"
fi

# -------- OPTIMIZED path setup --------
SANDBOX_PATH="/usr/local/bin:""\
/usr/local/sbin:""\
/usr/bin:""\
/usr/sbin:""\
/bin:""\
/sbin:""\
/usr/bin/site_perl"

EXTRA_BINDS=()
EXTRA_DIRS=()

# Helper: opt_bind (only used when --allow-host-tools is set)
opt_bind() {
    local host_p="$1"
    local sand_p="$2"
    if [[ -d "${host_p}" ]]; then
        EXTRA_BINDS+=(--ro-bind "${host_p}" "${sand_p}")
    fi
}

# Bind host tools only if explicitly requested
if [[ "${ALLOW_HOST_TOOLS}" -eq 1 ]]; then
    info "Binding host development tools (--allow-host-tools)"

    # User binaries
    if [[ -d "${HOME}/.local/bin" ]]; then
        EXTRA_BINDS+=(--ro-bind "${HOME}/.local/bin" "/home/gaeta/.local/bin")
        SANDBOX_PATH="${SANDBOX_PATH}:/home/gaeta/.local/bin"
    fi

    # Mise
    opt_bind "${HOME}/.local/share/mise" "/home/gaeta/.local/share/mise"
    opt_bind "${HOME}/.config/mise" "/home/gaeta/.config/mise"
    if [[ -d "${HOME}/.local/share/mise/shims" ]]; then
        SANDBOX_PATH="${SANDBOX_PATH}:/home/gaeta/.local/share/mise/shims"
    fi

    # uv
    if [[ -d "${HOME}/.local/share/uv" ]]; then
        EXTRA_BINDS+=(--ro-bind "${HOME}/.local/share/uv" "/home/gaeta/.local/share/uv")
        if [[ "${HOST_HOME}" != "/home/gaeta" ]]; then
            EXTRA_DIRS+=(--dir "${HOST_HOME}")
            EXTRA_BINDS+=(--ro-bind "${HOME}/.local/share/uv" "${HOST_HOME}/.local/share/uv")
        fi
    fi

    # Pyenv
    if [[ -d "${HOME}/.pyenv" ]]; then
        EXTRA_BINDS+=(--ro-bind "${HOME}/.pyenv" "/home/gaeta/.pyenv")
        SANDBOX_PATH="${SANDBOX_PATH}:/home/gaeta/.pyenv/shims:/home/gaeta/.pyenv/bin"
        PYENV_ROOT_SANDBOX="/home/gaeta/.pyenv"

        # Mirror pyenv into original host home path for existing venvs
        if [[ "${HOST_HOME}" != "/home/gaeta" ]]; then
            EXTRA_DIRS+=(--dir "${HOST_HOME}")
            EXTRA_BINDS+=(--ro-bind "${HOME}/.pyenv" "${HOST_HOME}/.pyenv")
        fi
    fi

    # Rust
    if [[ -d "${HOME}/.rustup" ]]; then
        EXTRA_BINDS+=(--ro-bind "${HOME}/.rustup" "/home/gaeta/.rustup")
        RUSTUP_HOME_SANDBOX="/home/gaeta/.rustup"
    fi
    if [[ -d "${HOME}/.cargo" ]]; then
        EXTRA_BINDS+=(--ro-bind "${HOME}/.cargo" "/home/gaeta/.cargo")
        SANDBOX_PATH="${SANDBOX_PATH}:/home/gaeta/.cargo/bin"
        CARGO_HOME_SANDBOX="/home/gaeta/.cargo"
    elif [[ -d "${HOME}/.cargo/bin" ]]; then
        EXTRA_BINDS+=(--ro-bind "${HOME}/.cargo/bin" "/home/gaeta/.cargo/bin")
        SANDBOX_PATH="${SANDBOX_PATH}:/home/gaeta/.cargo/bin"
        CARGO_HOME_SANDBOX="/home/gaeta/.cargo"
    fi

    # Config files
    [[ -f "${HOME}/.npmrc" ]] && EXTRA_BINDS+=(--ro-bind "${HOME}/.npmrc" "/home/gaeta/.npmrc")
    [[ -f "${HOME}/.pypirc" ]] && EXTRA_BINDS+=(--ro-bind "${HOME}/.pypirc" "/home/gaeta/.pypirc")
fi

# Project-local state for mise (always)
if [[ -n "${PROJECT_DIR}" ]]; then
    mkdir -p "${PROJECT_DIR}/.local/state/mise"
    EXTRA_BINDS+=(--bind "${PROJECT_DIR}/.local/state/mise" "/home/gaeta/.local/state/mise")
fi

# Project-local Cargo binaries
if [[ -d "${PROJECT_DIR}/.cargo/bin" ]]; then
    EXTRA_BINDS+=(--bind "${PROJECT_DIR}/.cargo/bin" "/home/gaeta/.cargo/bin")
    SANDBOX_PATH="/home/gaeta/.cargo/bin:${SANDBOX_PATH}"
fi

# Python virtual environments (project-local)
if [[ -d "${PROJECT_DIR}/.venv/bin" ]]; then
    EXTRA_BINDS+=(--bind "${PROJECT_DIR}/.venv/bin" "${SANDBOX_WORKDIR}/.venv/bin")
    SANDBOX_PATH="${SANDBOX_WORKDIR}/.venv/bin:${SANDBOX_PATH}"
fi

# Node.js project-local binaries
if [[ -d "${PROJECT_DIR}/node_modules/.bin" ]]; then
    EXTRA_BINDS+=(--bind "${PROJECT_DIR}/node_modules/.bin" "${SANDBOX_WORKDIR}/node_modules/.bin")
    SANDBOX_PATH="${SANDBOX_WORKDIR}/node_modules/.bin:${SANDBOX_PATH}"
fi

# Go project-local binaries
if [[ -d "${PROJECT_DIR}/bin" && -f "${PROJECT_DIR}/go.mod" ]]; then
    EXTRA_BINDS+=(--bind "${PROJECT_DIR}/bin" "${SANDBOX_WORKDIR}/bin")
    SANDBOX_PATH="${SANDBOX_WORKDIR}/bin:${SANDBOX_PATH}"
fi

# -------- Infrastructure Protection --------
PROTECTED_INFRA_DIRS=(
    ".git"
    ".github"
    ".turbo"
    ".next"
    "dist"
    "build"
    "target"
    ".cargo"
)

PROTECTED_INFRA_FILES=(
    ".gitignore"
    "package-lock.json"
    "poetry.lock"
    "Cargo.lock"
    "pnpm-lock.yaml"
    "yarn.lock"
)

SAFE_BINDS=()
if [[ "${ALLOW_INFRA}" -eq 0 ]]; then
    for dir in "${PROTECTED_INFRA_DIRS[@]}"; do
        if [[ "${dir}" == ".git" && "${ALLOW_GIT}" -eq 1 ]]; then
            continue
        fi
        if [[ "${dir}" == "node_modules" && "${ALLOW_NODE_MODULES}" -eq 1 ]]; then
            continue
        fi
        if [[ "${dir}" == ".venv" && "${ALLOW_VENV}" -eq 1 ]]; then
            continue
        fi

        if [[ -d "${PROJECT_DIR}/${dir}" ]]; then
            SAFE_BINDS+=(--ro-bind "${PROJECT_DIR}/${dir}" "${SANDBOX_WORKDIR}/${dir}")
            info "Protecting ${dir}/ (read-only)"
        fi
    done

    for file in "${PROTECTED_INFRA_FILES[@]}"; do
        if [[ -f "${PROJECT_DIR}/${file}" ]]; then
            SAFE_BINDS+=(--ro-bind "${PROJECT_DIR}/${file}" "${SANDBOX_WORKDIR}/${file}")
            info "Protecting ${file} (read-only)"
        fi
    done
fi

# -------- run sandbox --------
BWRAP_CMD=(
    bwrap
    --ro-bind /usr /usr
    --ro-bind /bin /bin
    --ro-bind /lib /lib
)

if [[ "${BWRAP_DISABLE_USERNS_SUPPORTED}" -eq 1 ]]; then
    BWRAP_CMD=(bwrap --unshare-user "${BWRAP_CMD[@]:1}")
    BWRAP_CMD+=(--disable-userns)
else
    BWRAP_CMD=(bwrap --unshare-user-try "${BWRAP_CMD[@]:1}")
fi

if [[ -d /lib64 ]]; then
    BWRAP_CMD+=(--ro-bind /lib64 /lib64)
fi

if [[ -d /sys ]]; then
    BWRAP_CMD+=(--ro-bind /sys /sys)
fi

if [[ -d /run ]]; then
    BWRAP_CMD+=(--ro-bind /run /run)
fi

BWRAP_CMD+=(--ro-bind /etc /etc)

if [[ "${RESTRICT_DEV}" -eq 1 ]]; then
    BWRAP_CMD+=(
        --dev-bind /dev/null /dev/null
        --dev-bind /dev/zero /dev/zero
        --dev-bind /dev/random /dev/random
        --dev-bind /dev/urandom /dev/urandom
        --dev-bind /dev/tty /dev/tty
        --tmpfs /dev/shm
    )
else
    BWRAP_CMD+=(--dev /dev)
fi

BWRAP_CMD+=(
    --proc /proc
    --tmpfs /tmp
    --tmpfs /home
    --dir /home/gaeta
    --dir /home/gaeta/.local
    --dir /home/gaeta/.local/share
    --dir /home/gaeta/.config
    --dir /home/gaeta/.config/opencode
    --dir /home/gaeta/.cache
)

BWRAP_CMD+=("${EXTRA_DIRS[@]}")
BWRAP_CMD+=("${EXTRA_BINDS[@]}")
if [[ "${SANDBOX_WORKDIR}" != "/" ]]; then
    BWRAP_CMD+=(--dir "${SANDBOX_WORKDIR}")
fi
BWRAP_CMD+=("${BIND_FLAG}" "${PROJECT_DIR}" "${SANDBOX_WORKDIR}")

if [[ ${#SAFE_BINDS[@]} -gt 0 ]]; then
    BWRAP_CMD+=("${SAFE_BINDS[@]}")
fi

# Data/cache binding (always for persistence)
BWRAP_CMD+=(
    --bind "${OPENCODE_DATA}" /home/gaeta/.local/share/opencode
    --bind "${OPENCODE_CACHE}" /home/gaeta/.cache/opencode
)

# Config overlay: ONLY bind specific config files, not the directory
if [[ -n "${CUSTOM_CONFIG}" ]]; then
    if [[ ! -f "${CUSTOM_CONFIG}" ]]; then
        error "Selected config file not found: ${CUSTOM_CONFIG}"
        exit 1
    fi
    BWRAP_CMD+=(--ro-bind "${CUSTOM_CONFIG}" /home/gaeta/.config/opencode/opencode.json)
    info "Using config: ${CUSTOM_CONFIG}"
else
    info "No opencode.json config found, OpenCode will use defaults"
fi

if [[ -n "${TUI_CONFIG}" ]]; then
    if [[ ! -f "${TUI_CONFIG}" ]]; then
        error "Selected TUI config file not found: ${TUI_CONFIG}"
        exit 1
    fi
    BWRAP_CMD+=(--ro-bind "${TUI_CONFIG}" /home/gaeta/.config/opencode/tui.json)
    info "Using TUI config: ${TUI_CONFIG}"
else
    info "No tui.json config found, OpenCode TUI will use defaults"
fi

if [[ -n "${PROJECTED_AGENTS_DIR}" && -d "${PROJECTED_AGENTS_DIR}" ]]; then
    BWRAP_CMD+=(--ro-bind "${PROJECTED_AGENTS_DIR}" /home/gaeta/.config/opencode/agents)
    info "Using projected agents directory: ${PROJECTED_AGENTS_DIR}"
fi

if [[ -n "${PROJECTED_COMMANDS_DIR}" && -d "${PROJECTED_COMMANDS_DIR}" ]]; then
    BWRAP_CMD+=(--ro-bind "${PROJECTED_COMMANDS_DIR}" /home/gaeta/.config/opencode/commands)
    info "Using projected commands directory: ${PROJECTED_COMMANDS_DIR}"
fi

if [[ -n "${PROJECTED_MODES_DIR}" && -d "${PROJECTED_MODES_DIR}" ]]; then
    BWRAP_CMD+=(--ro-bind "${PROJECTED_MODES_DIR}" /home/gaeta/.config/opencode/modes)
    info "Using projected modes directory: ${PROJECTED_MODES_DIR}"
fi

if [[ -n "${PROJECTED_PLUGINS_DIR}" && -d "${PROJECTED_PLUGINS_DIR}" ]]; then
    BWRAP_CMD+=(--ro-bind "${PROJECTED_PLUGINS_DIR}" /home/gaeta/.config/opencode/plugins)
    info "Using projected plugins directory: ${PROJECTED_PLUGINS_DIR}"
fi

BWRAP_CMD+=(--chdir "${SANDBOX_WORKDIR}")
BWRAP_CMD+=("${NET_FLAGS[@]}")
BWRAP_CMD+=(
    --die-with-parent
    --clearenv
    --setenv PATH "${SANDBOX_PATH}"
    --setenv HOME /home/gaeta
    --setenv USER gaeta
    --setenv LOGNAME gaeta
    --setenv MISE_SKIP_ACTIVATE 1
    --setenv UV_LINK_MODE copy
)

if [[ "${TTY_SESSION_MODE}" == "strict" ]]; then
    BWRAP_CMD+=(--new-session)
    info "TTY session mode: strict (${TTY_SESSION_REASON})"
else
    info "TTY session mode: compatibility (${TTY_SESSION_REASON})"
fi

if [[ -n "${PYENV_ROOT_SANDBOX:-}" ]]; then
    BWRAP_CMD+=(--setenv PYENV_ROOT "${PYENV_ROOT_SANDBOX}")
fi

if [[ -n "${RUSTUP_HOME_SANDBOX:-}" ]]; then
    BWRAP_CMD+=(--setenv RUSTUP_HOME "${RUSTUP_HOME_SANDBOX}")
fi

if [[ -n "${CARGO_HOME_SANDBOX:-}" ]]; then
    BWRAP_CMD+=(--setenv CARGO_HOME "${CARGO_HOME_SANDBOX}")
fi

if [[ -n "${PYO3_PYTHON:-}" ]]; then
    BWRAP_CMD+=(--setenv PYO3_PYTHON "${SANDBOX_WORKDIR}/.venv/bin/python")
fi

BWRAP_CMD+=("${OPENCODE_BIN}" "${OPENCODE_ARGS[@]}")

# ====== PARANOID MODE: Execution Decision ======

# Determine if paranoid mode should be active
USE_PARANOID=0
LANDLOCK_CHECK_RC=0

if [[ "${REQUIRE_LANDLOCK}" -eq 1 && "${LANDRUN_AVAILABLE}" -eq 0 ]]; then
    error "--require-landlock set, but landrun is not available in PATH"
    update_phase "error"
    append_session_log "landlock requirement failed: landrun missing"
    exit 1
fi

if [[ "${NOT_PARANOID}" -eq 0 && "${LANDRUN_AVAILABLE}" -eq 1 ]]; then
    if check_landlock_support; then
        USE_PARANOID=1
    else
        LANDLOCK_CHECK_RC=$?
        if [[ "${LANDLOCK_CHECK_RC}" -eq 2 ]]; then
            update_phase "error"
            append_session_log "landlock requirement failed: kernel support unavailable"
            exit 1
        fi
    fi
fi

if [[ "${USE_PARANOID}" -eq 1 ]]; then
    update_phase "build-landrun"
    info_blue "🔒 Paranoid mode enabled (defense-in-depth: Landlock + Bubblewrap)"
    info_blue "Using landrun: ${LANDRUN_BIN} (Landlock ABI v${LANDLOCK_ABI_VERSION})"

    # Build landrun wrapper
    translate_paths_to_landrun
    translate_network_to_landrun
    build_landrun_command BWRAP_CMD

    write_command_json "paranoid" "${LANDRUN_BIN}"
    append_session_log "launch mode=paranoid net=${NET_MODE} fs=${FS_MODE}"
    update_phase "execute"
    info "Launching gaeta paranoid sandbox..."
    exec "${LANDRUN_CMD[@]}"
else
    update_phase "build-bwrap"
    if [[ "${NOT_PARANOID}" -eq 1 && "${LANDRUN_AVAILABLE}" -eq 1 ]]; then
        info "Running in standard mode (bubblewrap only, --not-paranoid)"
    elif [[ "${LANDRUN_AVAILABLE}" -eq 0 ]]; then
        info "Running in standard mode (bubblewrap only, landrun not available)"
    fi

    write_command_json "bubblewrap-only" "bwrap"
    append_session_log "launch mode=bubblewrap-only net=${NET_MODE} fs=${FS_MODE}"
    update_phase "execute"
    info "Launching gaeta sandbox..."
    exec "${BWRAP_CMD[@]}"
fi
