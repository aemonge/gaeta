import pathlib
import re
import sys


def section_body(text: str, heading: str) -> str:
    pattern = re.compile(rf"^##\s+{re.escape(heading)}\s*$", re.MULTILINE)
    match = pattern.search(text)
    if not match:
        return ""
    start = match.end()
    remaining = text[start:]
    next_heading = re.search(r"^##\s+", remaining, re.MULTILINE)
    if next_heading:
        return remaining[: next_heading.start()].strip()
    return remaining.strip()


project_path = pathlib.Path(sys.argv[1])
status_path = pathlib.Path(sys.argv[2])
checklist_path = pathlib.Path(sys.argv[3])

project_text = project_path.read_text(encoding="utf-8") if project_path.exists() else ""
status_text = status_path.read_text(encoding="utf-8") if status_path.exists() else ""
checklist_text = checklist_path.read_text(encoding="utf-8") if checklist_path.exists() else ""

resume_prompt_body = section_body(project_text, "Resume Prompt")
resume_prompt = ""
for line in resume_prompt_body.splitlines():
    line = line.strip()
    if line.startswith("`") and line.endswith("`") and len(line) > 2:
        resume_prompt = line.strip("`")
        break

if not resume_prompt:
    phase_line = section_body(status_text, "Current phase").splitlines()
    phase_value = phase_line[0].strip() if phase_line else "unknown"
    next_step_line = section_body(status_text, "Next step").splitlines()
    next_value = " ".join(line.strip() for line in next_step_line if line.strip()) if next_step_line else "(not defined)"

    pending = []
    in_current_sprint = False
    for raw in checklist_text.splitlines():
        line = raw.strip()
        if line.startswith("## "):
            in_current_sprint = line == "## Current Sprint"
            continue
        if in_current_sprint and line.startswith("- [ ] "):
            pending.append(line[6:].strip())

    resume_prompt = (
        f"Phase: {phase_value}. Next: {next_value}. "
        f"Pending sprint items: {', '.join(pending[:3]) if pending else 'none'}. "
        "Read AGENTS.md and docs/.gaeta files plus PROJECT.md and GAETA.md. "
        "Provide a read-only handoff summary and propose the first implementation slice and validation commands."
    )

print(resume_prompt)
PY
)

if [[ -z "${resume_prompt}" ]]; then
    error "failed to resolve resume prompt"
    return 1
fi

    opencode_bin="${OPENCODE_BIN:-${OPENCODE_BIN_DEFAULT}}"
    resume_agent="${GAETA_RESUME_AGENT:-plan}"

    if [[ -z "${resume_agent}" ]]; then
        resume_agent="plan"
    fi

    if [[ "${show_only}" -eq 1 ]]; then
        printf 'gaeta resume\n'
        printf '  project: %s\n' "${target_project}"
        printf '  opencode: %s\n' "${opencode_bin}"
        printf '  agent: %s\n' "${resume_agent}"
        printf '  launch: %s %s -- --agent %s --prompt "%s"\n' "${GAETA_SELF_PATH}" "${target_project}" "${resume_agent}" "${resume_prompt}"
        printf '\nResume prompt\n  %s\n' "${resume_prompt}"
        return 0
    fi

    exec "${GAETA_SELF_PATH}" "${target_project}" -- --agent "${resume_agent}" --prompt "${resume_prompt}"
}

