run_proposal_command() {
  local action="${1:-}"
  shift || true

  local target_project="$PWD"

  if [[ -z "$action" || "$action" == "-h" || "$action" == "--help" ]]; then
    cat <<'PROPOSAL_HELP'
Usage:
  gaeta proposal create [PROJECT_DIR] "TITLE"
  gaeta proposal list [PROJECT_DIR]
  gaeta proposal approve [PROJECT_DIR] <latest|PROPOSAL_PATH|PROPOSAL_ID>
  gaeta proposal reject [PROJECT_DIR] <latest|PROPOSAL_PATH|PROPOSAL_ID> [REASON]

Approval-gated proposal workflow:
  create   Write a pending proposal under docs/.gaeta/proposals/
  list     Show proposal files and statuses
  approve  Mark proposal approved and append decision log entry
  reject   Mark proposal rejected and append decision log entry
PROPOSAL_HELP
    return 0
  fi

  case "$action" in
    create)
      if [[ $# -ge 2 && -d "${1}" ]]; then
        target_project="$1"
        shift
      fi
      if [[ $# -lt 1 ]]; then
        error "proposal create usage: gaeta proposal create [PROJECT_DIR] \"TITLE\""
        return 1
      fi
      ;;
    list)
      if [[ $# -ge 1 && -d "${1}" ]]; then
        target_project="$1"
        shift
      fi
      ;;
    approve)
      if [[ $# -ge 2 && -d "${1}" ]]; then
        target_project="$1"
        shift
      fi
      if [[ $# -lt 1 ]]; then
        error "proposal approve usage: gaeta proposal approve [PROJECT_DIR] <latest|PROPOSAL_PATH|PROPOSAL_ID>"
        return 1
      fi
      ;;
    reject)
      if [[ $# -ge 2 && -d "${1}" ]]; then
        target_project="$1"
        shift
      fi
      if [[ $# -lt 1 ]]; then
        error "proposal reject usage: gaeta proposal reject [PROJECT_DIR] <latest|PROPOSAL_PATH|PROPOSAL_ID> [REASON]"
        return 1
      fi
      ;;
    *)
      error "unknown proposal action: ${action}"
      return 1
      ;;
  esac

  if [[ ! -d "$target_project" ]]; then
    error "proposal project directory does not exist: ${target_project}"
    return 1
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    error "python3 is required for proposal command"
    return 1
  fi

  target_project="$(realpath "$target_project")"
  if ! require_project_initialized "$target_project" "proposal"; then
    return 1
  fi
  local proposals_dir="${target_project}/docs/.gaeta/proposals"

  if [[ "$action" == "create" ]]; then
    local title="$*"
    if ! python3 - "$proposals_dir" "$title" <<'PY'
import datetime
import pathlib
import re
import sys

proposals_dir = pathlib.Path(sys.argv[1])
title = " ".join(sys.argv[2:]).strip()

if not title:
    print("gaeta: proposal title is required", file=sys.stderr)
    raise SystemExit(1)

timestamp = datetime.datetime.now(datetime.timezone.utc)
slug = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-") or "proposal"
proposal_id = f"{timestamp.strftime('%Y%m%d-%H%M%S')}-{slug[:48]}"
proposal_path = proposals_dir / f"{proposal_id}.md"

body = (
    "# Proposal\n\n"
    f"- ID: {proposal_id}\n"
    "- Status: pending\n"
    f"- Created: {timestamp.isoformat(timespec='seconds')}\n"
    "- Approved: n/a\n"
    "- Rejected: n/a\n\n"
    "## Title\n\n"
    f"{title}\n\n"
    "## Summary\n\n"
    "- Pending capture via /propose.\n\n"
    "## Scope\n\n"
    "- Pending capture via /propose.\n\n"
    "## Validation\n\n"
    "- Pending capture via /propose.\n\n"
    "## Decision log\n\n"
    f"- [{timestamp.isoformat(timespec='seconds')}] created via gaeta proposal create\n"
)

proposals_dir.mkdir(parents=True, exist_ok=True)
proposal_path.write_text(body, encoding="utf-8")
print(str(proposal_path))
PY
    then
      return 1
    fi
    return 0
  fi

  if [[ "$action" == "list" ]]; then
    if ! python3 - "$proposals_dir" <<'PY'
import pathlib
import re
import sys

proposals_dir = pathlib.Path(sys.argv[1])
if not proposals_dir.exists():
    print(f"gaeta: no proposals directory at {proposals_dir}")
    raise SystemExit(0)

rows = []
for path in sorted(proposals_dir.glob("*.md")):
    text = path.read_text(encoding="utf-8")
    status_match = re.search(r"^- Status:\s*(.+)$", text, re.MULTILINE)
    status = status_match.group(1).strip() if status_match else "unknown"
    rows.append((path.name, status))

if not rows:
    print(f"gaeta: no proposals found in {proposals_dir}")
    raise SystemExit(0)

for name, status in rows:
    print(f"{name}\t{status}")
PY
    then
      return 1
    fi
    return 0
  fi

  local selector="${1:-latest}"
  shift || true
  local reject_reason="${*:-Rejected via gaeta proposal reject.}"

  if ! python3 - "$proposals_dir" "$action" "$selector" "$reject_reason" <<'PY'
import datetime
import pathlib
import re
import sys


def resolve_proposal(proposals_dir: pathlib.Path, selector: str) -> pathlib.Path:
    files = sorted(proposals_dir.glob("*.md"))
    if not files:
        print(f"gaeta: no proposals found in {proposals_dir}", file=sys.stderr)
        raise SystemExit(1)

    if selector == "latest":
        pending = []
        for path in files:
            text = path.read_text(encoding="utf-8")
            status_match = re.search(r"^- Status:\s*(.+)$", text, re.MULTILINE)
            status = status_match.group(1).strip().lower() if status_match else "unknown"
            if status == "pending":
                pending.append(path)
        if pending:
            return sorted(pending, key=lambda p: p.stat().st_mtime)[-1]
        return sorted(files, key=lambda p: p.stat().st_mtime)[-1]

    direct = pathlib.Path(selector)
    if direct.exists() and direct.is_file():
        return direct

    matches = [path for path in files if selector in path.name]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        print(f"gaeta: selector '{selector}' matches multiple proposals", file=sys.stderr)
        raise SystemExit(1)

    print(f"gaeta: proposal not found for selector '{selector}'", file=sys.stderr)
    raise SystemExit(1)


proposals_dir = pathlib.Path(sys.argv[1])
action = sys.argv[2]
selector = sys.argv[3]
reason = sys.argv[4].strip() if len(sys.argv) > 4 else ""

if not proposals_dir.exists():
    print(f"gaeta: no proposals directory at {proposals_dir}", file=sys.stderr)
    raise SystemExit(1)

proposal_path = resolve_proposal(proposals_dir, selector)
text = proposal_path.read_text(encoding="utf-8")
timestamp = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")

if action == "approve":
    text = re.sub(r"^- Status:\s*.+$", "- Status: approved", text, count=1, flags=re.MULTILINE)
    text = re.sub(r"^- Approved:\s*.+$", f"- Approved: {timestamp}", text, count=1, flags=re.MULTILINE)
    text = re.sub(r"^- Rejected:\s*.+$", "- Rejected: n/a", text, count=1, flags=re.MULTILINE)
    decision_line = f"- [{timestamp}] approved via gaeta proposal approve"
elif action == "reject":
    text = re.sub(r"^- Status:\s*.+$", "- Status: rejected", text, count=1, flags=re.MULTILINE)
    text = re.sub(r"^- Approved:\s*.+$", "- Approved: n/a", text, count=1, flags=re.MULTILINE)
    text = re.sub(r"^- Rejected:\s*.+$", f"- Rejected: {timestamp}", text, count=1, flags=re.MULTILINE)
    reason_value = reason or "Rejected via gaeta proposal reject."
    decision_line = f"- [{timestamp}] rejected via gaeta proposal reject: {reason_value}"
else:
    print(f"gaeta: unsupported action '{action}'", file=sys.stderr)
    raise SystemExit(1)

section_pattern = re.compile(r"^##\s+Decision log\s*$", re.MULTILINE)
section_match = section_pattern.search(text)
if section_match:
    insert_at = len(text)
    after = text[section_match.end():]
    next_heading = re.search(r"^##\s+", after, re.MULTILINE)
    if next_heading:
        insert_at = section_match.end() + next_heading.start()
    block = text[:insert_at].rstrip()
    block = f"{block}\n{decision_line}\n"
    text = block + text[insert_at:]
else:
    text = text.rstrip() + f"\n\n## Decision log\n\n{decision_line}\n"

proposal_path.write_text(text if text.endswith("\n") else text + "\n", encoding="utf-8")
print(str(proposal_path))
PY
  then
    return 1
  fi

  return 0
}

detect_file_source_mode() {
  local gaeta_file="$1"
  local opencode_file="$2"

  if [[ -f "$gaeta_file" && -f "$opencode_file" ]]; then
    printf 'merged'
    return
  fi
  if [[ -f "$gaeta_file" ]]; then
    printf 'gaeta'
    return
  fi
  if [[ -f "$opencode_file" ]]; then
    printf 'opencode'
    return
  fi
  printf 'none'
}

