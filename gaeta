run_tasks_fallback() {
    local checklist_path="$1"
    local status_path="$2"
    shift

    local action="${1:-list}"
    case "${action}" in
    list)
        if [[ -f "${checklist_path}" ]]; then
            cat "${checklist_path}"
            return 0
        fi
        error "checklist not found: ${checklist_path}"
        return 1
        ;;
    path)
        printf '%s\n' "${checklist_path}"
        return 0
        ;;
    add)
        shift || true
        if [[ $# -lt 1 ]]; then
            error "fallback usage: gaeta tasks add \"task text\""
            return 1
        fi
        mkdir -p "$(dirname "${checklist_path}")"
        if [[ ! -f "${checklist_path}" ]]; then
            printf '# Checklist\n\n## Current Sprint\n\n' >"${checklist_path}"
        fi
        printf -- '- [ ] %s\n' "$*" >>"${checklist_path}"
        sync_status_from_checklist "${checklist_path}" "${status_path}" "tasks-fallback-add" || true
        info "added task to ${checklist_path}"
        return 0
        ;;
    done)
        shift || true
        if [[ $# -lt 1 ]]; then
            error "fallback usage: gaeta tasks done \"task text\""
            return 1
        fi
        if [[ ! -f "${checklist_path}" ]]; then
            error "checklist not found: ${checklist_path}"
            return 1
        fi
        if ! command -v python3 >/dev/null 2>&1; then
            error "python3 is required for fallback done operation"
            return 1
        fi
        python3 - "${checklist_path}" "$*" <<'PY'
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])
needle = sys.argv[2].strip().lower()
lines = path.read_text(encoding="utf-8").splitlines()
updated = False

for idx, line in enumerate(lines):
    if updated:
        break
    if not line.startswith("- [ ] "):
        continue
    content = re.sub(r"^\- \[ \] ", "", line).strip().lower()
    if needle in content:
        lines[idx] = line.replace("- [ ]", "- [x]", 1)
        updated = True

if not updated:
    print(f"gaeta: no matching open task for: {needle}", file=sys.stderr)
    sys.exit(1)

path.write_text("\n".join(lines) + "\n", encoding="utf-8")
PY
        sync_status_from_checklist "${checklist_path}" "${status_path}" "tasks-fallback-done" || true
        info "marked matching task as done in ${checklist_path}"
        return 0
        ;;
    sync)
        sync_status_from_checklist "${checklist_path}" "${status_path}" "tasks-fallback-sync"
        return $?
        ;;
    *)
        error "fallback task action not supported: ${action}"
        error "supported fallback actions: list, path, add, done, sync"
        return 1
        ;;
    esac
}

run_tasks_command() {
    local project_dir="$1"
    shift
    local -a task_args=("$@")

    local gaeta_dir="${project_dir}/docs/.gaeta"
    local checklist_path="${gaeta_dir}/checklist.md"
    local status_path="${gaeta_dir}/status.md"

    if [[ ! -d "${gaeta_dir}" ]]; then
        warning "docs/.gaeta not found in ${project_dir}; using fallback mode"
        run_tasks_fallback "${checklist_path}" "${status_path}" "${task_args[@]}"
        return $?
    fi

    if [[ "${GAETA_TASKS_FORCE_FALLBACK:-0}" != "1" ]] && command -v mdt >/dev/null 2>&1; then
        local -a mdt_cmd=(mdt)
        if ! contains_option "--dir" "${task_args[@]}" && ! contains_option "-d" "${task_args[@]}"; then
            mdt_cmd+=(--dir "${gaeta_dir}")
        fi
        if ! contains_option "--inbox" "${task_args[@]}" && ! contains_option "-i" "${task_args[@]}"; then
            mdt_cmd+=(--inbox "${checklist_path}")
        fi
        mdt_cmd+=("${task_args[@]}")
        info "Running tasks via mdt in ${gaeta_dir}"
        if ! "${mdt_cmd[@]}"; then
            return 1
        fi
        sync_status_from_checklist "${checklist_path}" "${status_path}" "tasks-mdt"
        return $?
    fi

    warning "mdt unavailable or fallback forced; using built-in fallback tasks mode"
    run_tasks_fallback "${checklist_path}" "${status_path}" "${task_args[@]}"
}

detect_file_source_mode() {
    local gaeta_file="$1"
    local opencode_file="$2"

    if [[ -f "${gaeta_file}" && -f "${opencode_file}" ]]; then
        printf 'merged'
        return
    fi
    if [[ -f "${gaeta_file}" ]]; then
        printf 'gaeta'
        return
    fi
    if [[ -f "${opencode_file}" ]]; then
        printf 'opencode'
        return
    fi
    printf 'none'
}

detect_dir_source_mode() {
    local gaeta_dir="$1"
    local opencode_dir="$2"

