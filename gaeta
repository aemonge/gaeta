    for row in sorted(set(manual_unverified)):
        print(f"    - {row}")

if install_mode:
    print("  note: restart OpenCode for plugin changes to load")

if lock_payload["plugins"]["missing_ids"] and not install_mode:
    print("  next: gaeta profile sync --install")
elif lock_payload["plugins"]["missing_ids"]:
    print("  next: resolve manual plugin installs, then rerun: gaeta profile sync")
else:
    print("  next: gaeta doctor --strict .")
PY
  then
    error "profile sync failed"
    return 1
  fi

  return 0
}

