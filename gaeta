render_doctor_json() {
    local target_project="$1"
    local fail_count="$2"
    local warn_count="$3"
    local generated_at="$4"

    if ! command -v python3 >/dev/null 2>&1; then
        error "python3 is required for --json output"
        return 1
    fi

    local rows_file
    rows_file="$(mktemp)"
    printf '%s\n' "${DOCTOR_CHECK_ROWS[@]}" >"${rows_file}"

    python3 - "${target_project}" "${fail_count}" "${warn_count}" "${generated_at}" "${rows_file}" <<'PY'
import json
import pathlib
import sys

project = sys.argv[1]
fail_count = int(sys.argv[2])
warn_count = int(sys.argv[3])
generated_at = sys.argv[4]
rows_file = pathlib.Path(sys.argv[5])

section_key_map = {
    "Dependencies": "dependencies",
    "Config Sources": "config_sources",
    "Directory Sources": "directory_sources",
    "Projection Artifacts": "projection_artifacts",
    "Sandbox Check": "sandbox_check",
    "Workflow Files": "workflow_files",
}

checks = {value: [] for value in section_key_map.values()}

for raw_line in rows_file.read_text(encoding="utf-8").splitlines():
    line = raw_line.rstrip("\n")
    if not line:
        continue
    parts = line.split("\t", 3)
    if len(parts) != 4:
        continue
    section, label, status, details = parts
    key = section_key_map.get(section)
    if key is None:
        continue
    checks[key].append({
        "label": label,
        "status": status,
        "details": details,
    })

status = "ok"
if fail_count > 0:
    status = "fail"
elif warn_count > 0:
    status = "warn"

payload = {
    "timestamp": generated_at,
    "project": project,
    "status": status,
    "summary": {
        "fail": fail_count,
        "warn": warn_count,
    },
    "checks": checks,
}

print(json.dumps(payload, indent=2, ensure_ascii=True))
PY

    rm -f "${rows_file}"
}

