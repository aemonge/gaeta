#!/usr/bin/env bash

# gaeta - Safe wrapper for OpenCode using bubblewrap
# Homepage: https://github.com/anomalyco/opencode
# Author: Andres Monge (aemonge)
# License: MIT

set -euo pipefail

readonly PROGRAM_NAME="gaeta"
readonly PROGRAM_VERSION="0.9.0"
readonly OPENCODE_BIN_DEFAULT="/usr/bin/opencode"
GAETA_SELF_PATH="$(realpath "$0" 2>/dev/null || printf '%s' "$0")"
readonly GAETA_SELF_PATH

# Colors for output
readonly RED='\033[0;31m'
readonly YELLOW='\033[1;33m'
readonly GREEN='\033[0;32m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m' # No Color

usage() {
    cat <<'USAGE_EOF'
gaeta 0.9.0
Safe OpenCode wrapper using bubblewrap with optional Landlock defense-in-depth.

Usage:
  gaeta doctor [PROJECT_DIR]
  gaeta resume [--show] [PROJECT_DIR]
  gaeta r [--show] [PROJECT_DIR]
  gaeta tasks [TASK_ARGS...]
  gaeta [options] [PROJECT_DIR] [-- [OPENCODE_ARGS...]]

Options:
  doctor                 Run gaeta self-inspection checks
  resume, r              Show phase/next-step resume context
  tasks                  Run task workflow via mdt (with fallback)
  -h, --help              Show this help and exit
  -V, --version           Show version and exit
  -n, --no-net            Disable network access inside the sandbox (default: on)
  -b, --bin PATH          Path to opencode binary (default: "opencode")
  -q, --quiet             Suppress informational output
      --validate          Run comprehensive validation tests and exit
      --ro                Mount project directory read-only (safe)
      --rw                Mount project directory read-write (default)
      --allow-git         Allow write access to .git directory (default: read-only)
      --allow-node-modules Allow write access to node_modules (default: read-write)
      --allow-venv        Allow write access to .venv (default: read-write)
      --allow-infra       Allow write access to all protected infra dirs
      --restrict-dev      Restrict /dev access to essential devices only
      --quiet-landlock    Suppress Landlock fallback warnings
      --quite-landlock    Alias for --quiet-landlock
      --require-landlock  Fail if Landlock cannot be enabled
      --strict-tty        Force strict TTY isolation mode (enables --new-session)
  --allow-host-tools  Bind host user tools (~/.local/bin, mise, pyenv, uv, rustup/cargo, etc) (default)
  --no-host-tools     Disable binding host user tools
USAGE_EOF

    # Add --not-paranoid flag only if landrun is available
    if command -v landrun >/dev/null 2>&1; then
        cat <<'PARANOID_EOF'
  -P, --not-paranoid      Disable Landlock defense-in-depth (use bubblewrap only)
PARANOID_EOF
    fi

    cat <<'USAGE_END'

Arguments:
  DOCTOR_PROJECT_DIR     Optional target project for doctor mode
  TASK_ARGS              Passed to mdt when available
  PROJECT_DIR            Project directory exposed at same absolute path (default: $PWD)
  OPENCODE_ARGS           Arguments passed verbatim to opencode after "--"

Environment:
  OPENCODE_BIN            Overrides default opencode binary
  GAETA_NET              "on" to enable network by default ("off" otherwise)
  GAETA_FS_MODE          "ro" (secure) or "rw" (default, allow writes)
  GAETA_TASKS_FORCE_FALLBACK  "1" to bypass mdt and use built-in tasks fallback
  GAETA_DOCTOR_SKIP_SANDBOX   "1" to skip nested sandbox check in gaeta doctor
  GAETA_TTY_MODE         "auto" (default), "compat", or "strict"
  GAETA_RESUME_AGENT     Resume agent name (default: "plan")

Protected Directories (read-only by default):
  .git, .turbo, .next, dist, build, target, .cargo
  .gitignore, package-lock.json, poetry.lock, Cargo.lock, .github/

Config Precedence (automatic):
  1. Merge ~/.config/opencode/opencode.json + ~/.config/gaeta/opencode.json
     (gaeta keys override opencode keys, recursively)
  2. ~/.config/gaeta/opencode.json (if exists)
  3. ~/.config/opencode/opencode.json (if exists)
  4. No config binding (OpenCode defaults)

TUI Config Precedence (automatic):
  1. Merge ~/.config/opencode/tui.json + ~/.config/gaeta/tui.json
     (gaeta keys override opencode keys, recursively)
  2. ~/.config/gaeta/tui.json (if exists)
  3. ~/.config/opencode/tui.json (if exists)
  4. No TUI config binding (OpenCode defaults)

Directory Projection (automatic):
  - Targets: agents/, commands/, modes/, plugins/
  - Strategy: mirror projection (not symlink)
  - Merge mode: opencode base overlaid by gaeta content
  - Structured files (*.json, *.yaml, *.yml) merge recursively by key

Paranoid Mode (Defense-in-Depth):
  When landrun is available, gaeta uses two-layer sandbox:
    1. Landlock (syscall-level enforcement via landrun)
    2. Bubblewrap (namespace isolation)

  This provides protection even if bubblewrap configuration errors occur.
  Use --not-paranoid to disable and revert to bubblewrap-only mode.

  Requirements:
    - landrun binary in PATH
    - Linux kernel 5.13+ with Landlock enabled
    - Linux kernel 6.7+ for network syscall restrictions

Examples:
  gaeta doctor             # inspect gaeta config and projection health
  gaeta doctor --json      # inspect gaeta health as JSON
  gaeta doctor ../repo     # inspect another project
  gaeta resume             # launch opencode with resume prompt
  gaeta resume --show      # show resolved resume command without launching
  GAETA_RESUME_AGENT=plan gaeta r --show # preview resume agent launch
  gaeta r                  # short alias for resume
  gaeta tasks              # run mdt in docs/.gaeta (or fallback view)
  gaeta tasks -m           # add multiple tasks via mdt
  gaeta                    # rw sandbox of $PWD, infra protected, paranoid if available
  gaeta --validate         # run comprehensive validation tests
  gaeta --ro               # read-only sandbox of $PWD
  gaeta --allow-git        # allow .git writes
  gaeta --allow-host-tools # bind host dev tools (mise, cargo, etc)
  gaeta --strict-tty       # force strict TTY session isolation
  gaeta --not-paranoid     # disable Landlock layer (bubblewrap only)
  gaeta -n myproj -- --verbose # network off, pass --verbose to opencode

Security Note:
  HOME is set to /home/gaeta on tmpfs (fully isolated from your real home).
  OpenCode config files are overlaid from gaeta/opencode paths with key-level merge.
  Interactive runs default to TTY compatibility mode (no --new-session) to improve
  redraw/resizing behavior; use --strict-tty for strict session isolation.
  Host tools are bound by default (use --allow-host-tools to be explicit).
  The project is writable by default, but critical infrastructure directories
  are protected read-only unless you explicitly opt in.
USAGE_END
}

version() {
    local landlock_status="unavailable"
    local landrun_path="not found"
    local paranoid_status="unavailable"

    if command -v landrun >/dev/null 2>&1; then
        landrun_path=$(command -v landrun)
        if [[ -f /sys/kernel/security/landlock/version ]]; then
            local abi_version
            abi_version=$(cat /sys/kernel/security/landlock/version 2>/dev/null || echo "0")
            landlock_status="available (ABI v${abi_version})"
            paranoid_status="enabled by default"
        else
            landlock_status="landrun found but kernel support missing"
            paranoid_status="disabled (no kernel support)"
        fi
    fi

    echo "${PROGRAM_NAME} ${PROGRAM_VERSION}"
    echo "Paranoid mode: ${paranoid_status}"
    echo "Landlock support: ${landlock_status}"
    echo "Landrun: ${landrun_path}"
}

error() {
    echo -e "${RED}${PROGRAM_NAME}: $*${NC}" >&2
}

warning() {
    echo -e "${YELLOW}${PROGRAM_NAME}: $*${NC}" >&2
}

info() {
    if [[ "${QUIET}" -eq 0 ]]; then
        echo -e "${GREEN}${PROGRAM_NAME}: $*${NC}" >&2
    fi
}

info_blue() {
    if [[ "${QUIET}" -eq 0 ]]; then
        echo -e "${BLUE}${PROGRAM_NAME}: $*${NC}" >&2
    fi
}

json_escape() {
    local value="$1"
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    value=${value//$'\n'/\\n}
    printf '%s' "${value}"
}

init_projection_paths() {
    GAETA_META_DIR="${PROJECT_DIR}/.gaeta"
    GAETA_PROJECTION_DIR="${GAETA_META_DIR}/projection"
    GAETA_PROJECTION_META="${GAETA_PROJECTION_DIR}/projection.json"
    GAETA_PROJECTED_OPENCODE_JSON="${GAETA_PROJECTION_DIR}/opencode.json"
    GAETA_PROJECTED_TUI_JSON="${GAETA_PROJECTION_DIR}/tui.json"
}

merge_structured_config_files() {
    local base_file="$1"
    local override_file="$2"
    local output_file="$3"

    if ! command -v python3 >/dev/null 2>&1; then
        error "python3 is required for config merge: ${override_file} over ${base_file}"
        return 1
    fi

    python3 - "${base_file}" "${override_file}" "${output_file}" <<'PY'
import json
import pathlib
import sys


def deep_merge(base, override):
    if isinstance(base, dict) and isinstance(override, dict):
        merged = dict(base)
        for key, value in override.items():
            if key in merged:
                merged[key] = deep_merge(merged[key], value)
            else:
                merged[key] = value
        return merged
    return override


def load_structured(path):
    suffix = path.suffix.lower()
    text = path.read_text(encoding="utf-8")
    if suffix == ".json":
        return json.loads(text), "json"
    if suffix in {".yaml", ".yml"}:
        try:
            import yaml
        except Exception as exc:  # pragma: no cover
            raise RuntimeError(
                f"YAML merge requires PyYAML for file: {path}"
            ) from exc
        return yaml.safe_load(text), "yaml"
    raise RuntimeError(f"Unsupported config format: {path}")


def dump_structured(path, data, fmt):
    if fmt == "json":
        path.write_text(json.dumps(data, indent=2, ensure_ascii=True) + "\n", encoding="utf-8")
        return
    if fmt == "yaml":
        try:
            import yaml
        except Exception as exc:  # pragma: no cover
            raise RuntimeError(
                f"YAML output requires PyYAML for file: {path}"
            ) from exc
        rendered = yaml.safe_dump(data, sort_keys=False)
        path.write_text(rendered, encoding="utf-8")
        return
    raise RuntimeError(f"Unsupported output format: {fmt}")


base_path = pathlib.Path(sys.argv[1])
override_path = pathlib.Path(sys.argv[2])
output_path = pathlib.Path(sys.argv[3])

base_data, base_fmt = load_structured(base_path)
override_data, override_fmt = load_structured(override_path)

if base_fmt != override_fmt:
    raise RuntimeError(
        f"Config format mismatch: {base_path.name} ({base_fmt}) vs {override_path.name} ({override_fmt})"
    )

merged = deep_merge(base_data, override_data)
output_path.parent.mkdir(parents=True, exist_ok=True)
dump_structured(output_path, merged, base_fmt)
PY
}

select_overlay_config() {
    local config_name="$1"
    local gaeta_file="$2"
    local opencode_file="$3"
    local merged_file="$4"

    if [[ -f "${gaeta_file}" && -f "${opencode_file}" ]]; then
        if ! merge_structured_config_files "${opencode_file}" "${gaeta_file}" "${merged_file}"; then
            error "failed to merge ${config_name}: ${gaeta_file} over ${opencode_file}"
            return 1
        fi
        info "Using merged ${config_name} (gaeta precedence): ${gaeta_file} + ${opencode_file}"
        printf '%s' "${merged_file}"
        return 0
    fi

    if [[ -f "${gaeta_file}" ]]; then
        printf '%s' "${gaeta_file}"
        return 0
    fi

    if [[ -f "${opencode_file}" ]]; then
        printf '%s' "${opencode_file}"
        return 0
    fi

    printf ''
}

merge_structured_directory_tree() {
    local base_dir="$1"
    local override_dir="$2"
    local output_dir="$3"

    if ! command -v python3 >/dev/null 2>&1; then
        error "python3 is required for directory merge: ${override_dir} over ${base_dir}"
        return 1
    fi

    python3 - "${base_dir}" "${override_dir}" "${output_dir}" <<'PY'
import json
import pathlib
import shutil
import sys


def deep_merge(base, override):
    if isinstance(base, dict) and isinstance(override, dict):
        merged = dict(base)
        for key, value in override.items():
            if key in merged:
                merged[key] = deep_merge(merged[key], value)
            else:
                merged[key] = value
        return merged
    return override


def load_structured(path):
    suffix = path.suffix.lower()
    text = path.read_text(encoding="utf-8")
    if suffix == ".json":
        return json.loads(text), "json"
    if suffix in {".yaml", ".yml"}:
        try:
            import yaml
        except Exception as exc:  # pragma: no cover
            raise RuntimeError(
                f"YAML merge requires PyYAML for file: {path}"
            ) from exc
        return yaml.safe_load(text), "yaml"
    raise RuntimeError(f"Unsupported structured format: {path}")


def dump_structured(path, data, fmt):
    if fmt == "json":
        path.write_text(json.dumps(data, indent=2, ensure_ascii=True) + "\n", encoding="utf-8")
        return
    if fmt == "yaml":
        try:
            import yaml
        except Exception as exc:  # pragma: no cover
            raise RuntimeError(
                f"YAML output requires PyYAML for file: {path}"
            ) from exc
        path.write_text(yaml.safe_dump(data, sort_keys=False), encoding="utf-8")
        return
    raise RuntimeError(f"Unsupported output format: {fmt}")


def copy_tree(src, dst):
    for path in src.rglob("*"):
        rel = path.relative_to(src)
        target = dst / rel
        if path.is_symlink():
            continue
        if path.is_dir():
            target.mkdir(parents=True, exist_ok=True)
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, target)


def overlay_tree(base, override, out):
    structured_ext = {".json", ".yaml", ".yml"}
    for path in override.rglob("*"):
        rel = path.relative_to(override)
        target = out / rel
        if path.is_symlink():
            continue
        if path.is_dir():
            target.mkdir(parents=True, exist_ok=True)
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        if target.exists() and target.is_file() and path.suffix.lower() in structured_ext and target.suffix.lower() in structured_ext:
            base_data, base_fmt = load_structured(target)
            override_data, override_fmt = load_structured(path)
            if base_fmt != override_fmt:
                raise RuntimeError(f"Config format mismatch: {target} vs {path}")
            merged = deep_merge(base_data, override_data)
            dump_structured(target, merged, base_fmt)
            continue
        shutil.copy2(path, target)


base = pathlib.Path(sys.argv[1])
override = pathlib.Path(sys.argv[2])
out = pathlib.Path(sys.argv[3])

if out.exists():
    shutil.rmtree(out)
out.mkdir(parents=True, exist_ok=True)

copy_tree(base, out)
overlay_tree(base, override, out)
PY
}

materialize_projection_directory() {
    local dir_name="$1"
    local gaeta_dir="$2"
    local opencode_dir="$3"
    local merged_target_dir="$4"
    local projected_target_dir="$5"

    MATERIALIZED_DIR_PATH=""
    MATERIALIZED_DIR_SOURCE="none"

    if [[ -d "${gaeta_dir}" && -d "${opencode_dir}" ]]; then
        if ! merge_structured_directory_tree "${opencode_dir}" "${gaeta_dir}" "${merged_target_dir}"; then
            error "failed to merge ${dir_name} projection directory"
            return 1
        fi
        MATERIALIZED_DIR_SOURCE="merged"
        MATERIALIZED_DIR_PATH="${merged_target_dir}"
    elif [[ -d "${gaeta_dir}" ]]; then
        rm -rf "${merged_target_dir}"
        mkdir -p "${merged_target_dir}"
        cp -a "${gaeta_dir}/." "${merged_target_dir}/"
        MATERIALIZED_DIR_SOURCE="gaeta"
        MATERIALIZED_DIR_PATH="${merged_target_dir}"
    elif [[ -d "${opencode_dir}" ]]; then
        rm -rf "${merged_target_dir}"
        mkdir -p "${merged_target_dir}"
        cp -a "${opencode_dir}/." "${merged_target_dir}/"
        MATERIALIZED_DIR_SOURCE="opencode"
        MATERIALIZED_DIR_PATH="${merged_target_dir}"
    else
        rm -rf "${merged_target_dir}"
    fi

    if [[ -n "${MATERIALIZED_DIR_PATH}" && "${GAETA_META_ENABLED:-0}" -eq 1 ]]; then
        rm -rf "${projected_target_dir}"
        mkdir -p "${projected_target_dir}"
        cp -a "${MATERIALIZED_DIR_PATH}/." "${projected_target_dir}/"
        MATERIALIZED_DIR_PATH="${projected_target_dir}"
    elif [[ "${GAETA_META_ENABLED:-0}" -eq 1 ]]; then
        rm -rf "${projected_target_dir}"
    fi

    return 0
}

materialize_projection_files() {
    local selected_opencode="$1"
    local selected_tui="$2"

    local source_opencode=""
    local source_tui=""
    local active_opencode="${selected_opencode}"
    local active_tui="${selected_tui}"
    local active_agents="${PROJECTED_AGENTS_DIR}"
    local active_commands="${PROJECTED_COMMANDS_DIR}"
    local active_modes="${PROJECTED_MODES_DIR}"
    local active_plugins="${PROJECTED_PLUGINS_DIR}"

    if [[ "${GAETA_META_ENABLED:-0}" -ne 1 ]]; then
        CUSTOM_CONFIG="${active_opencode}"
        TUI_CONFIG="${active_tui}"
        return 0
    fi

    mkdir -p "${GAETA_PROJECTION_DIR}"

    if [[ -n "${selected_opencode}" && -f "${selected_opencode}" ]]; then
        source_opencode="${selected_opencode}"
        cp "${selected_opencode}" "${GAETA_PROJECTED_OPENCODE_JSON}"
        active_opencode="${GAETA_PROJECTED_OPENCODE_JSON}"
    else
        rm -f "${GAETA_PROJECTED_OPENCODE_JSON}" 2>/dev/null || true
    fi

    if [[ -n "${selected_tui}" && -f "${selected_tui}" ]]; then
        source_tui="${selected_tui}"
        cp "${selected_tui}" "${GAETA_PROJECTED_TUI_JSON}"
        active_tui="${GAETA_PROJECTED_TUI_JSON}"
    else
        rm -f "${GAETA_PROJECTED_TUI_JSON}" 2>/dev/null || true
    fi

    cat >"${GAETA_PROJECTION_META}" <<EOF
{
  "timestamp": "$(date -Iseconds)",
  "strategy": "generated projection",
  "project_dir": "$(json_escape "${PROJECT_DIR}")",
  "opencode_json": {
    "source": "$(json_escape "${source_opencode}")",
    "generated": "$(json_escape "${active_opencode}")",
    "present": $([[ -n "${active_opencode}" ]] && printf 'true' || printf 'false')
  },
  "tui_json": {
    "source": "$(json_escape "${source_tui}")",
    "generated": "$(json_escape "${active_tui}")",
    "present": $([[ -n "${active_tui}" ]] && printf 'true' || printf 'false')
  },
  "directories": {
    "strategy": "mirror",
    "agents": {
      "source_mode": "$(json_escape "${PROJECTED_AGENTS_SOURCE}")",
      "gaeta_source": "$(json_escape "${GAETA_AGENTS_DIR}")",
      "opencode_source": "$(json_escape "${OPENCODE_AGENTS_DIR}")",
      "generated": "$(json_escape "${active_agents}")",
      "present": $([[ -n "${active_agents}" ]] && printf 'true' || printf 'false')
    },
    "commands": {
      "source_mode": "$(json_escape "${PROJECTED_COMMANDS_SOURCE}")",
      "gaeta_source": "$(json_escape "${GAETA_COMMANDS_DIR}")",
      "opencode_source": "$(json_escape "${OPENCODE_COMMANDS_DIR}")",
      "generated": "$(json_escape "${active_commands}")",
      "present": $([[ -n "${active_commands}" ]] && printf 'true' || printf 'false')
    },
    "modes": {
      "source_mode": "$(json_escape "${PROJECTED_MODES_SOURCE}")",
      "gaeta_source": "$(json_escape "${GAETA_MODES_DIR}")",
      "opencode_source": "$(json_escape "${OPENCODE_MODES_DIR}")",
      "generated": "$(json_escape "${active_modes}")",
      "present": $([[ -n "${active_modes}" ]] && printf 'true' || printf 'false')
    },
    "plugins": {
      "source_mode": "$(json_escape "${PROJECTED_PLUGINS_SOURCE}")",
      "gaeta_source": "$(json_escape "${GAETA_PLUGINS_DIR}")",
      "opencode_source": "$(json_escape "${OPENCODE_PLUGINS_DIR}")",
      "generated": "$(json_escape "${active_plugins}")",
      "present": $([[ -n "${active_plugins}" ]] && printf 'true' || printf 'false')
    }
  }
}
EOF

    CUSTOM_CONFIG="${active_opencode}"
    TUI_CONFIG="${active_tui}"
}

prepare_projection_artifacts() {
    # Ensure OpenCode data/cache dirs exist (config handled separately)
    OPENCODE_DATA="${HOME}/.local/share/opencode"
    OPENCODE_CACHE="${HOME}/.cache/opencode"
    mkdir -p "${OPENCODE_DATA}/sessions"
    mkdir -p "${OPENCODE_DATA}/permissions"
    mkdir -p "${OPENCODE_CACHE}"

    MERGED_CONFIG_DIR="${OPENCODE_CACHE}/gaeta-merged"
    mkdir -p "${MERGED_CONFIG_DIR}"

    if ! CUSTOM_CONFIG=$(select_overlay_config "opencode.json" "${GAETA_CONFIG}" "${OPENCODE_DEFAULT_CONFIG}" "${MERGED_CONFIG_DIR}/opencode.json"); then
        return 1
    fi

    if ! TUI_CONFIG=$(select_overlay_config "tui.json" "${GAETA_TUI_CONFIG}" "${OPENCODE_DEFAULT_TUI_CONFIG}" "${MERGED_CONFIG_DIR}/tui.json"); then
        return 1
    fi

    if ! materialize_projection_directory "agents" "${GAETA_AGENTS_DIR}" "${OPENCODE_AGENTS_DIR}" "${MERGED_CONFIG_DIR}/agents" "${GAETA_PROJECTION_DIR}/agents"; then
        return 1
    fi
    PROJECTED_AGENTS_DIR="${MATERIALIZED_DIR_PATH}"
    PROJECTED_AGENTS_SOURCE="${MATERIALIZED_DIR_SOURCE}"

    if ! materialize_projection_directory "commands" "${GAETA_COMMANDS_DIR}" "${OPENCODE_COMMANDS_DIR}" "${MERGED_CONFIG_DIR}/commands" "${GAETA_PROJECTION_DIR}/commands"; then
        return 1
    fi
    PROJECTED_COMMANDS_DIR="${MATERIALIZED_DIR_PATH}"
    PROJECTED_COMMANDS_SOURCE="${MATERIALIZED_DIR_SOURCE}"

    if ! materialize_projection_directory "modes" "${GAETA_MODES_DIR}" "${OPENCODE_MODES_DIR}" "${MERGED_CONFIG_DIR}/modes" "${GAETA_PROJECTION_DIR}/modes"; then
        return 1
    fi
    PROJECTED_MODES_DIR="${MATERIALIZED_DIR_PATH}"
    PROJECTED_MODES_SOURCE="${MATERIALIZED_DIR_SOURCE}"

    if ! materialize_projection_directory "plugins" "${GAETA_PLUGINS_DIR}" "${OPENCODE_PLUGINS_DIR}" "${MERGED_CONFIG_DIR}/plugins" "${GAETA_PROJECTION_DIR}/plugins"; then
        return 1
    fi
    PROJECTED_PLUGINS_DIR="${MATERIALIZED_DIR_PATH}"
    PROJECTED_PLUGINS_SOURCE="${MATERIALIZED_DIR_SOURCE}"

    materialize_projection_files "${CUSTOM_CONFIG}" "${TUI_CONFIG}"
    return 0
}

contains_option() {
    local needle="$1"
    shift
    local arg
    for arg in "$@"; do
        if [[ "${arg}" == "${needle}" ]]; then
            return 0
        fi
    done
    return 1
}

sync_status_from_checklist() {
    local checklist_path="$1"
    local status_path="$2"
    local trigger="$3"

    if [[ ! -f "${checklist_path}" ]]; then
        warning "workflow sync skipped: checklist not found at ${checklist_path}"
        return 0
    fi

    if [[ ! -f "${status_path}" ]]; then
        warning "workflow sync skipped: status not found at ${status_path}"
        return 0
    fi

    if ! command -v python3 >/dev/null 2>&1; then
        warning "workflow sync skipped: python3 not available"
        return 0
    fi

    if ! python3 - "${checklist_path}" "${status_path}" "${trigger}" <<'PY'
import pathlib
import re
import sys


def replace_or_append_section(text: str, heading: str, body: str) -> str:
    header_pattern = re.compile(rf"^##\s+{re.escape(heading)}\s*$", re.MULTILINE)
    header_match = header_pattern.search(text)
    section = f"## {heading}\n\n{body.strip()}\n"

    if header_match is None:
        base = text.rstrip()
        if base:
            return f"{base}\n\n{section}\n"
        return f"{section}\n"

    section_start = header_match.start()
    content_start = header_match.end()
    next_header = re.search(r"^##\s+", text[content_start:], re.MULTILINE)
    if next_header is None:
        return f"{text[:section_start].rstrip()}\n\n{section}\n"

    section_end = content_start + next_header.start()
    prefix = text[:section_start].rstrip()
    suffix = text[section_end:].lstrip("\n")
    if prefix:
        return f"{prefix}\n\n{section}\n{suffix.rstrip()}\n"
    return f"{section}\n{suffix.rstrip()}\n"


checklist_path = pathlib.Path(sys.argv[1])
status_path = pathlib.Path(sys.argv[2])
trigger = sys.argv[3]

checklist_text = checklist_path.read_text(encoding="utf-8")
status_text = status_path.read_text(encoding="utf-8")

pending = []
in_current_sprint = False
for raw in checklist_text.splitlines():
    line = raw.strip()
    if line.startswith("## "):
        in_current_sprint = line == "## Current Sprint"
        continue
    if in_current_sprint and line.startswith("- [ ] "):
        pending.append(line[6:].strip())

if pending:
    in_progress_body = "\n".join(f"- {item}" for item in pending[:3])
    next_step_body = pending[0]
else:
    in_progress_body = "- No open checklist items in `## Current Sprint`."
    next_step_body = "Review backlog and define the next checklist task."

updated = replace_or_append_section(status_text, "In progress", in_progress_body)
updated = replace_or_append_section(updated, "Next step", next_step_body)

status_path.write_text(updated, encoding="utf-8")
print(f"synced status from checklist ({trigger})")
PY
    then
        warning "workflow sync failed for ${status_path}"
        return 1
    fi

    info "synced workflow status from checklist (${trigger})"
    return 0
