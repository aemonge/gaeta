  local force=0
  local profile_name="$DEFAULT_PROFILE"
  local install_after_init=1
  local include_notify=1
  local -a init_positionals=()

  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'INIT_HELP'
Usage:
  gaeta init [--force] [--profile minimal|recommended|experimental] [--install|--no-install] [--no-notify] [PROJECT_DIR]

Scaffolds required gaeta workflow files:
  - PROJECT.md
