# -------- OPTIMIZED path setup --------
SANDBOX_PATH="/usr/local/bin:""\
/usr/local/sbin:""\
/usr/bin:""\
/usr/sbin:""\
/bin:""\
/sbin:""\
/usr/bin/site_perl"

