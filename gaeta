print_doctor_check() {
  local label="$1"
  local state="$2"
  local details="$3"
  local normalized_details="${details//$'\n'/ | }"
  normalized_details="${normalized_details//$'\t'/ }"

  if [[ "${DOCTOR_COLLECT:-0}" -eq 1 ]]; then
    DOCTOR_CHECK_ROWS+=("$CURRENT_DOCTOR_SECTION"$'\t'"$label"$'\t'"$state"$'\t'"$normalized_details")
  fi

  if [[ "${DOCTOR_JSON:-0}" -eq 1 ]]; then
    return
  fi

  local state_color="$NC"
  case "$state" in
    ok)
      state_color="$GREEN"
      ;;
    warn)
      state_color="$YELLOW"
      ;;
    fail)
      state_color="$RED"
      ;;
  esac

  if [[ "${DOCTOR_VERBOSE:-0}" -eq 1 ]]; then
    printf '  %-22s %b[%s]%b %s\n' "$label" "$state_color" "$state" "$NC" "$normalized_details"
    return
  fi

  if [[ "$state" == "warn" || "$state" == "fail" ]]; then
    printf '  %b[%s]%b %s/%s - %s\n' "$state_color" "$state" "$NC" "$CURRENT_DOCTOR_SECTION" "$label" "$normalized_details"
  fi
}

