      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "model": "openai/gpt-5.3-codex",
  "autoupdate": true,
  "permission": {
    "read": {
      "./*": "allow",
      "./**/*": "allow",
      "/proc/*": "allow",
      "/tmp/opencode-*": "allow",
      "*.env*": "deny",
      "*id_rsa*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*": "deny"
    },
    "edit": {
